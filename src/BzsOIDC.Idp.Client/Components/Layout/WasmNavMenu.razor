@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<NavMenu> L

<div class="demo-nav wasm-nav-menu">
    <div class="demo-brand wasm-nav-brand-row">
        <a class="demo-brand-link sidebar-brand" href="/">
            <span class="sidebar-brand__mark demo-brand-mark" aria-hidden="true">
                <img src="/oidc-brand.jpg" alt="" width="36" height="36" />
            </span>
            <span class="demo-brand-copy sidebar-brand__text">
                <strong>BzsOIDC</strong>
            </span>
        </a>
        <BzsButton Class="wasm-nav-collapse demo-navigation-toggle demo-navigation-toggle--close"
                   Variant="BzsButtonVariant.Secondary"
                   Size="BzsButtonSize.Small"
                   StartIcon="@BzsIcons.ChevronLeft"
                   AccessibleName="@L["CloseNavigation"]"
                   data-demo-navigation-toggle="true"
                   data-demo-navigation-toggle-mode="close"
                   aria-controls="demo-navigation-drawer"
                   aria-expanded="true"
                   Click="ToggleNavigation" />
    </div>
    @* BzsNavItem 0.6.0 does not expose route activation callbacks yet. This
       native event boundary observes both pointer and keyboard activation while
       retaining BzsNavMenu/BzsNavItem active-state and focus styling. *@
    <div class="demo-nav-section wasm-nav-scroll" @onclick="CloseNavigation" @onkeydown="HandleNavigationKeyDown">
        <p class="demo-nav-heading" aria-hidden="true">@L["AdminArea"]</p>
        <BzsNavMenu AccessibleName="@L["PrimaryNavigation"]">
            <BzsNavItem Href="/" Label="@L["Home"]" Match="NavLinkMatch.All" Icon="NavIcons.Home" LinkAttributes="@DemoLinkAttributes" />
            <AuthorizeView>
                <NotAuthorized>
                    <BzsNavItem Href="/login" Label="@L["Login"]" Icon="NavIcons.Login" LinkAttributes="@DemoLinkAttributes" />
                </NotAuthorized>
                <Authorized>
                    <BzsNavItem Href="/admin/dashboard" Label="@L["Dashboard"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Dashboard" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/users" Label="@L["Users"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Users" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/roles" Label="@L["Roles"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Roles" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/clients" Label="@L["Clients"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Clients" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/scopes" Label="@L["Scopes"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Scopes" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/permissions" Label="@L["Permissions"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Permissions" LinkAttributes="@DemoLinkAttributes" />
                    <BzsNavItem Href="/admin/oidc-topology" Label="@L["Topology"]" Match="NavLinkMatch.Prefix" Icon="NavIcons.Topology" LinkAttributes="@DemoLinkAttributes" />
                </Authorized>
            </AuthorizeView>
        </BzsNavMenu>
    </div>
    <div class="demo-user wasm-nav-footer">
        <AuthorizeView Context="auth">
            <Authorized>
                <SidebarUserMenu Avatar="@GetAvatar(auth.User)"
                                 Name="@GetName(auth.User)"
                                 SecondaryText="@GetSecondary(auth.User)" />
                <a class="wasm-nav-logout" href="/logout" data-enhance-nav="false">@L["LogOut"]</a>
            </Authorized>
            <NotAuthorized>
                <SidebarUserMenu Avatar="G" Name="Guest" SecondaryText="@L["SignInToContinue"]" />
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    [Parameter] public EventCallback OnToggle { get; set; }

    private Task ToggleNavigation() => OnToggle.InvokeAsync();

    private static IReadOnlyDictionary<string, object> DemoLinkAttributes { get; } =
        new Dictionary<string, object>(StringComparer.OrdinalIgnoreCase)
        {
            ["class"] = "demo-nav-link sidebar-nav-item",
        };

    // Lucide geometry, flattened to a single path per icon for BzsIcon.
    private static class NavIcons
    {
        public static readonly BzsIconData Home = new(
            "M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10");

        public static readonly BzsIconData Login = new(
            "M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4 M10 17l5-5-5-5 M15 12H3");

        public static readonly BzsIconData Dashboard = new(
            "M3 3h7v7H3z M14 3h7v7h-7z M14 14h7v7h-7z M3 14h7v7H3z");

        public static readonly BzsIconData Users = new(
            "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 " +
            "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z " +
            "M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75");

        public static readonly BzsIconData Roles = new(
            "M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 " +
            "M12 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z " +
            "M19 8v6 M22 11h-6");

        public static readonly BzsIconData Clients = new(
            "M4 7h16 M4 12h16 M4 17h10 M20 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4z");

        public static readonly BzsIconData Scopes = new(
            "M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4z M9 12l2 2 4-5");

        public static readonly BzsIconData Permissions = new(
            "M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1 1 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z M9 12l2 2 4-4");

        public static readonly BzsIconData Topology = new(
            "M12 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M5 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M19 8a2 2 0 1 0 0-4 2 2 0 0 0 0 4z " +
            "M6.3 6.5 10.8 16 M17.7 6.5 13.2 16 M7 6h10");
    }

    private Task CloseNavigation() => OnNavigate.InvokeAsync();

    private Task HandleNavigationKeyDown(KeyboardEventArgs args)
    {
        return args.Key is "Enter" or " " ? CloseNavigation() : Task.CompletedTask;
    }

    private static string GetAvatar(ClaimsPrincipal user) => GetName(user) is { Length: > 0 } name ? name[..1].ToUpperInvariant() : "U";
    private static string GetName(ClaimsPrincipal user) => user.Identity?.Name ?? user.FindFirst("display_name")?.Value ?? user.FindFirst(ClaimTypes.Email)?.Value ?? "Authenticated user";
    private static string GetSecondary(ClaimsPrincipal user) => user.FindFirst(ClaimTypes.Email)?.Value ?? "Signed in";
}
