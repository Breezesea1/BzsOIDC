@inherits LayoutComponentBase
@using System.Globalization
@using Microsoft.Extensions.Localization
@using BzsOIDC.Idp.Client.Services.Theme
@inject IStringLocalizer<AuthLayout> L
@inject ThemePreferenceState ThemeState

<div class="auth-shell">
    <a class="wasm-skip-link" href="#auth-stage">@L["SkipToContent"]</a>

    <div class="auth-ambient" aria-hidden="true">
        <span class="auth-orb auth-orb--one"></span>
        <span class="auth-orb auth-orb--two"></span>
        <span class="auth-orb auth-orb--three"></span>
        <span class="auth-grid"></span>
    </div>

    <header class="auth-topbar">
        <a class="auth-brand" href="/">
            <span class="auth-brand__mark" aria-hidden="true">
                <img src="/oidc-brand.jpg" alt="" width="30" height="30" />
            </span>
            <span class="auth-brand__copy">
                <span class="auth-brand__name">BzsOIDC</span>
                <span class="auth-brand__tagline">@L["BrandTagline"]</span>
            </span>
        </a>
        <Preferences CurrentCulture="@CultureInfo.CurrentUICulture.Name" CurrentTheme="@ThemeState.RequestedTheme" />
    </header>

    <div class="auth-stage" id="auth-stage" tabindex="-1">
        <div class="auth-frame">
            @Body
        </div>
        <p class="auth-footnote">@L["FooterNote"]</p>
    </div>
</div>
