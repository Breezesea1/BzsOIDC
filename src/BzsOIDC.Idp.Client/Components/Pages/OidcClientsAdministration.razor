@page "/admin/clients"
@using System.Net
@using BzsOIDC.Idp.Client.Services.Oidc
@inject IOidcClientsClient Clients

<PageTitle>OIDC clients</PageTitle>
<AuthorizeView>
    <Authorized>
        <section class="admin-page" data-testid="clients-page">
            <header class="page-header">
                <div class="page-header__titles">
                    <h1>OIDC client administration</h1>
                    <p class="page-subtitle">Register and maintain applications that authenticate through this provider.</p>
                </div>
                <button class="btn btn--primary" type="button" @onclick="BeginCreate">New OIDC client</button>
            </header>

            <div class="toolbar">
                <div class="toolbar__search">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                        <path d="m21 21-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <input aria-label="Search clients" @bind="_search" @bind:event="oninput" placeholder="Search clients" />
                </div>
                <button class="btn btn--secondary" type="button" @onclick="RefreshAsync">Search</button>
                <button class="btn btn--ghost" type="button" @onclick="ClearSearchAsync">Clear</button>
            </div>

            @if (_error is not null)
            {
                <div class="alert alert--error" role="alert">@_error</div>
            }
            @if (_model is null)
            {
                <p class="loading-note" role="status" aria-live="polite">Loading…</p>
            }
            else
            {
                <div class="admin-card admin-card--table">
                    <table class="data-table" data-testid="clients-table">
                        <thead><tr><th>Client ID</th><th>Display name</th><th>Type</th><th class="data-table__actions-col">Actions</th></tr></thead>
                        <tbody>
                            @foreach (var client in _model.Items)
                            {
                                <tr>
                                    <td><code class="data-table__code">@client.ClientId</code></td>
                                    <td><span class="data-table__primary">@client.DisplayName</span></td>
                                    <td><span class="badge @(client.PublicClient ? "badge--info" : "badge--primary")">@(client.PublicClient ? "Public" : "Confidential")</span></td>
                                    <td class="data-table__actions">
                                        <button class="btn btn--ghost btn--small" type="button" @onclick="() => BeginEditAsync(client)">Edit</button>
                                        <button class="btn btn--danger-ghost btn--small" type="button" @onclick="() => DeleteAsync(client)">Delete</button>
                                        @if (!client.PublicClient)
                                        {
                                            <button class="btn btn--ghost btn--small" type="button" @onclick="() => RotateSecretAsync(client)">Rotate secret</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="table-summary">Showing @_model.Items.Count of @_model.TotalCount clients.</p>
            }

            @if (_editor is not null)
            {
                <section class="editor-card" aria-label="Client editor" data-testid="client-editor">
                    <h2 class="editor-card__title">@(_creating ? "New OIDC client" : "Edit client")</h2>
                    <div class="field-grid">
                        <label class="field"><span class="field__label">Client ID</span><input @bind="_editor.ClientId" disabled="@(!_creating)" /></label>
                        <label class="field"><span class="field__label">Display name</span><input @bind="_editor.DisplayName" /></label>
                        <label class="field"><span class="field__label">Client type</span>
                            <select @bind="_editor.PublicClientValue">
                                <option value="true">Public</option>
                                <option value="false">Confidential</option>
                            </select>
                        </label>
                        <label class="field"><span class="field__label">Authentication flow</span>
                            <select @bind="_editor.AuthFlow">
                                <option value="@OidcClientAuthFlow.AuthorizationCode">Authorization code</option>
                                <option value="@OidcClientAuthFlow.ClientCredentials">Client credentials</option>
                            </select>
                        </label>
                        <label class="field field--span"><span class="field__label">Scopes</span><input @bind="_editor.ScopesText" /></label>
                        <label class="field field--span"><span class="field__label">Redirect URIs</span><textarea rows="3" @bind="_editor.RedirectUrisText"></textarea></label>
                        <label class="field field--span"><span class="field__label">Post-logout redirect URIs</span><textarea rows="3" @bind="_editor.PostLogoutRedirectUrisText"></textarea></label>
                    </div>
                    <div class="editor-card__actions">
                        <button class="btn btn--primary" type="button" @onclick="SaveAsync">@(_creating ? "Create" : "Save")</button>
                        <button class="btn btn--ghost" type="button" @onclick="CancelEdit">Cancel</button>
                    </div>
                    @if (_conflict)
                    {
                        <div class="alert alert--warning" role="alert">This client changed elsewhere. Reload to continue; your edits are preserved.</div>
                    }
                </section>
            }

            @if (_generatedSecret is not null)
            {
                <section class="secret-callout" aria-label="Generated client secret" data-testid="generated-secret">
                    <div class="secret-callout__icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                            <path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                        </svg>
                    </div>
                    <div class="secret-callout__body">
                        <h2>Client secret generated</h2>
                        <p>Copy this secret now. It will not be shown again.</p>
                        <output>@_generatedSecret</output>
                    </div>
                    <button class="btn btn--ghost" type="button" @onclick="DismissSecret">Dismiss</button>
                </section>
            }
        </section>
    </Authorized>
    <NotAuthorized><p class="loading-note">Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private OidcClientListResponse? _model;
    private string _search = string.Empty;
    private ClientDraft? _editor;
    private string? _error;
    private bool _conflict;
    private string? _generatedSecret;
    private bool _creating;

    protected override Task OnInitializedAsync() => RefreshAsync();

    private async Task RefreshAsync()
    {
        try
        {
            _model = await Clients.ListAsync(_search);
            _error = null;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task ClearSearchAsync()
    {
        _search = string.Empty;
        await RefreshAsync();
    }

    private async Task BeginEditAsync(OidcClientResponse summary)
    {
        _error = null;
        try
        {
            var client = await Clients.GetAsync(summary.ClientId) ?? summary;
            _editor = ClientDraft.From(client);
            _creating = false;
            _conflict = false;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private void CancelEdit()
    {
        _editor = null;
        _creating = false;
        _conflict = false;
    }

    private async Task SaveAsync()
    {
        if (_editor is null)
        {
            return;
        }

        if (_creating && string.IsNullOrWhiteSpace(_editor.ClientId))
        {
            _error = "Client ID is required.";
            return;
        }

        if (string.IsNullOrWhiteSpace(_editor.DisplayName))
        {
            _error = "Display name is required.";
            return;
        }

        var request = _editor.ToRequest();
        using var response = _creating
            ? await Clients.CreateAsync(request)
            : await Clients.UpdateAsync(_editor.ClientId, request, _editor.ETag);
        if (!_creating && response.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            _conflict = true;
            _error = null;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _error = $"Unable to save client ({(int)response.StatusCode}).";
            return;
        }

        if (_creating)
        {
            var registration = await response.Content.ReadFromJsonAsync<OidcClientRegistrationResponse>();
            if (!string.IsNullOrWhiteSpace(registration?.ClientSecret)) _generatedSecret = registration.ClientSecret;
        }
        _editor = null;
        _creating = false;
        _conflict = false;
        await RefreshAsync();
    }

    private async Task DeleteAsync(OidcClientResponse client)
    {
        _error = null;
        using var response = await Clients.DeleteAsync(client.ClientId, client.ETag);
        if (response.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            _error = "This client changed elsewhere. Reload and try again.";
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _error = $"Unable to delete client ({(int)response.StatusCode}).";
            return;
        }

        if (_editor?.ClientId == client.ClientId)
        {
            _editor = null;
            _creating = false;
        }

        await RefreshAsync();
    }

    private async Task RotateSecretAsync(OidcClientResponse client)
    {
        _error = null;
        using var response = await Clients.RotateSecretAsync(client.ClientId, client.ETag);
        if (response.StatusCode == HttpStatusCode.PreconditionFailed)
        {
            _error = "This client changed elsewhere. Reload and try again.";
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _error = $"Unable to rotate client secret ({(int)response.StatusCode}).";
            return;
        }

        var secret = await response.Content.ReadFromJsonAsync<OidcClientSecretResponse>();
        if (secret is null || string.IsNullOrWhiteSpace(secret.ClientSecret))
        {
            _error = "The server did not return a client secret.";
            return;
        }

        _generatedSecret = secret.ClientSecret;
        await RefreshAsync();
        if (_editor?.ClientId == client.ClientId)
        {
            var refreshed = await Clients.GetAsync(client.ClientId);
            if (refreshed is not null)
            {
                _editor.ETag = refreshed.ETag;
            }
        }
    }

    private void DismissSecret() => _generatedSecret = null;

    private void BeginCreate()
    {
        _creating = true;
        _conflict = false;
        _error = null;
        _editor = new ClientDraft
        {
            ClientId = string.Empty,
            DisplayName = string.Empty,
            PublicClient = true,
            AuthFlow = OidcClientAuthFlow.AuthorizationCode,
            ScopesText = "openid, profile, api",
            RedirectUrisText = string.Empty,
            PostLogoutRedirectUrisText = string.Empty,
        };
    }

    private sealed class ClientDraft
    {
        public string ClientId { get; set; } = string.Empty;
        public string ETag { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public bool PublicClient { get; set; }
        public string PublicClientValue
        {
            get => PublicClient ? "true" : "false";
            set => PublicClient = bool.TryParse(value, out var result) && result;
        }
        public OidcClientAuthFlow AuthFlow { get; set; }
        public string ScopesText { get; set; } = string.Empty;
        public string RedirectUrisText { get; set; } = string.Empty;
        public string PostLogoutRedirectUrisText { get; set; } = string.Empty;

        public static ClientDraft From(OidcClientResponse client) => new()
        {
            ClientId = client.ClientId,
            ETag = client.ETag,
            DisplayName = client.DisplayName ?? string.Empty,
            PublicClient = client.PublicClient,
            AuthFlow = client.AuthFlow,
            ScopesText = string.Join(", ", client.Scopes),
            RedirectUrisText = string.Join(Environment.NewLine, client.RedirectUris),
            PostLogoutRedirectUrisText = string.Join(Environment.NewLine, client.PostLogoutRedirectUris),
        };

        public OidcClientUpdateRequest ToRequest() => new()
        {
            ClientId = ClientId,
            DisplayName = DisplayName.Trim(),
            PublicClient = PublicClient,
            AuthFlow = AuthFlow,
            RequireProofKeyForCodeExchange = AuthFlow == OidcClientAuthFlow.AuthorizationCode,
            ConsentType = AuthFlow == OidcClientAuthFlow.ClientCredentials
                ? OidcClientConsentType.External
                : OidcClientConsentType.Explicit,
            GrantTypes = AuthFlow == OidcClientAuthFlow.ClientCredentials ? ["client_credentials"] : ["authorization_code", "refresh_token"],
            Scopes = Split(ScopesText, ',') ,
            RedirectUris = Split(RedirectUrisText, '\n'),
            PostLogoutRedirectUris = Split(PostLogoutRedirectUrisText, '\n'),
        };

        private static string[] Split(string value, char separator) => value.Split(separator, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }
}
