@page "/admin/permissions"
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Permissions
@inject IPermissionTopologyClient Topology

<PageTitle>Permission topology</PageTitle>
<AuthorizeView>
    <Authorized>
        <section class="admin-page">
            <header class="page-header">
                <div class="page-header__titles">
                    <h1>Permission topology</h1>
                    <p class="page-subtitle">Protected resources and the permissions released through each scope.</p>
                </div>
                <button class="btn btn--ghost" type="button" @onclick="Refresh">Refresh</button>
            </header>

            @if (_error is not null)
            {
                <div class="alert alert--error" role="alert">@_error</div>
            }

            @if (_resources is null)
            {
                <p class="loading-note" role="status" aria-live="polite">Loading…</p>
            }
            else
            {
                <div class="permission-topology-grid">
                    <section class="admin-card topology-panel" aria-label="Protected resources">
                        <h2 class="topology-panel__title">Protected resources</h2>
                        <div class="topology-resource-list">
                            @foreach (var resource in _resources)
                            {
                                <button type="button" class="permission-resource @(resource.Key == _selected?.Key ? "is-active" : string.Empty)" aria-pressed="@(resource.Key == _selected?.Key)" @onclick="() => Select(resource)">
                                    <strong>@resource.DisplayName</strong>
                                    <span>@resource.Key · @resource.Permissions.Length permissions</span>
                                </button>
                            }
                        </div>
                    </section>
                    <section class="admin-card topology-panel" aria-label="Permission details">
                        @if (_selected is null)
                        {
                            <p class="loading-note">Select a protected resource.</p>
                        }
                        else
                        {
                            <h2 class="topology-panel__title">@_selected.DisplayName</h2>
                            <p class="topology-panel__lead">@_selected.Description</p>
                            <div class="permission-detail-list">
                                @foreach (var permission in _selected.Permissions)
                                {
                                    <article class="permission-detail">
                                        <strong>@permission.DisplayName</strong>
                                        <code>@permission.Name</code>
                                        <span>Release scopes: @string.Join(", ", permission.ReleaseScopes)</span>
                                        <span>Assigned roles: @permission.AssignedRoles.Length</span>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </div>
            }
        </section>
    </Authorized>
    <NotAuthorized><p class="loading-note">Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<ProtectedResourceDetail>? _resources;
    private ProtectedResourceDetail? _selected;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        try
        {
            _resources = await Topology.GetResourcesAsync() ?? [];
            _selected = _selected is null ? _resources.FirstOrDefault() : _resources.FirstOrDefault(resource => resource.Key == _selected.Key);
        }
        catch (HttpRequestException)
        {
            _error = "Unable to load permission topology.";
        }
    }

    private async Task Select(ProtectedResourceDetail resource)
    {
        _selected = await Topology.GetResourceAsync(resource.Key) ?? resource;
    }
}
