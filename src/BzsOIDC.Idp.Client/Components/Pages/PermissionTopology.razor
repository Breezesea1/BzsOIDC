@page "/admin/permissions"
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Permissions
@inject IPermissionTopologyClient Topology

<PageTitle>Permission topology</PageTitle>
<AuthorizeView>
    <Authorized>
        <h1>Permission topology</h1>
        <p>Protected resources and the permissions released through each scope.</p>
        @if (_resources is null)
        {
            <p>Loading…</p>
        }
        else
        {
            <div class="permission-topology-grid">
                <section aria-label="Protected resources">
                    <h2>Protected resources</h2>
                    <button type="button" @onclick="Refresh">Refresh</button>
                    @foreach (var resource in _resources)
                    {
                        <button type="button" class="permission-resource @(resource.Key == _selected?.Key ? "is-active" : string.Empty)" @onclick="() => Select(resource)">
                            <strong>@resource.DisplayName</strong><span>@resource.Key (@resource.Permissions.Length)</span>
                        </button>
                    }
                </section>
                <section aria-label="Permission details">
                    @if (_selected is null)
                    {
                        <p>Select a protected resource.</p>
                    }
                    else
                    {
                        <h2>@_selected.DisplayName</h2>
                        <p>@_selected.Description</p>
                        @foreach (var permission in _selected.Permissions)
                        {
                            <article class="permission-detail">
                                <strong>@permission.DisplayName</strong>
                                <code>@permission.Name</code>
                                <span>Release scopes: @string.Join(", ", permission.ReleaseScopes)</span>
                                <span>Assigned roles: @permission.AssignedRoles.Length</span>
                            </article>
                        }
                    }
                </section>
            </div>
        }
        @if (_error is not null) { <p role="alert">@_error</p> }
    </Authorized>
    <NotAuthorized><p>Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<ProtectedResourceDetail>? _resources;
    private ProtectedResourceDetail? _selected;
    private string? _error;

    protected override async Task OnInitializedAsync() => await Refresh();

    private async Task Refresh()
    {
        try
        {
            _resources = await Topology.GetResourcesAsync() ?? [];
            _selected = _selected is null ? _resources.FirstOrDefault() : _resources.FirstOrDefault(resource => resource.Key == _selected.Key);
        }
        catch (HttpRequestException)
        {
            _error = "Unable to load permission topology.";
        }
    }

    private async Task Select(ProtectedResourceDetail resource)
    {
        _selected = await Topology.GetResourceAsync(resource.Key) ?? resource;
    }
}
