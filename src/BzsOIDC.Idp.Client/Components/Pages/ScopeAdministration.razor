@page "/admin/scopes"
@using BzsOIDC.Idp.Client.Services.Scopes
@inject IScopesClient Scopes

<PageTitle>Scopes</PageTitle>
<AuthorizeView>
    <Authorized>
        <h1>Scopes</h1>
        <div class="scope-toolbar">
            <input aria-label="Search scopes" @bind="_search" @bind:event="oninput" />
            <button type="button" @onclick="Refresh">Refresh</button>
            <button type="button" @onclick="BeginCreate">New scope</button>
        </div>
        @if (_model is null)
        {
            <p>Loading…</p>
        }
        else
        {
            <table data-testid="scopes-table"><thead><tr><th>Name</th><th>Display name</th><th>Resources</th><th>Protected resources</th><th>Permissions</th><th></th></tr></thead>
            <tbody>@foreach (var item in _model.Items)
            {<tr><td>@item.Name</td><td>@item.DisplayName</td><td>@string.Join(", ", item.Resources)</td><td>@string.Join(", ", item.Clients)</td><td>@string.Join(", ", item.Permissions)</td><td><button type="button" @onclick="() => BeginEdit(item)">Edit</button>@if (!item.IsReserved) { <button type="button" @onclick="() => DeleteAsync(item)">Delete</button> }</td></tr>}</tbody></table>
            <p>Showing @_model.Items.Count of @_model.TotalCount</p>
        }
        @if (_editor is not null)
        {
            <section aria-label="Scope editor"><h2>@(_editing ? "Edit scope" : "New scope")</h2>
                <label>Name <input @bind="_editor.Name" disabled="@_editing" /></label>
                <label>Display name <input @bind="_editor.DisplayName" /></label>
                <label>Description <textarea @bind="_editor.Description"></textarea></label>
                <label>Resources <input @bind="_resourcesText" /></label>
                <button type="button" @onclick="Save">Save</button><button type="button" @onclick="Cancel">Cancel</button>
                @if (!string.IsNullOrEmpty(_error)) { <p role="alert">@_error</p> }
            </section>
        }
    </Authorized>
    <NotAuthorized><p>Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private OidcScopeListResponse? _model;
    private string _search = string.Empty;
    private OidcScopeUpsertRequest? _editor;
    private string _resourcesText = string.Empty;
    private string? _etag;
    private string? _error;
    private bool _editing;

    protected override async Task OnInitializedAsync() => await Refresh();
    private async Task Refresh() => _model = await Scopes.ListAsync(_search);
    private void BeginCreate() { _editing = false; _etag = null; _editor = new(); _resourcesText = string.Empty; _error = null; }
    private void BeginEdit(OidcScopeResponse item) { _editing = true; _etag = item.ETag; _editor = new() { Name = item.Name, DisplayName = item.DisplayName, Description = item.Description, Resources = item.Resources }; _resourcesText = string.Join(", ", item.Resources); _error = null; }
    private void Cancel() => _editor = null;
    private async Task Save()
    {
        if (_editor is null || string.IsNullOrWhiteSpace(_editor.Name)) { _error = "Name is required."; return; }
        var request = new OidcScopeUpsertRequest { Name = _editor.Name.Trim(), DisplayName = _editor.DisplayName, Description = _editor.Description, Resources = _resourcesText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) };
        using var response = _editing ? await Scopes.UpdateAsync(request.Name!, request, _etag ?? string.Empty) : await Scopes.CreateAsync(request);
        if (!response.IsSuccessStatusCode) { _error = response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed ? "The scope changed. Reload and try again." : "Unable to save scope."; return; }
        _editor = null; await Refresh();
    }

    private async Task DeleteAsync(OidcScopeResponse item)
    {
        if (item.IsReserved)
        {
            _error = "Reserved release scopes cannot be deleted.";
            return;
        }

        _error = null;
        using var response = await Scopes.DeleteAsync(item.Name, item.ETag);
        if (response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed)
        {
            _error = "The release scope changed. Reload and try again.";
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _error = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "The release scope is still referenced and cannot be deleted."
                : "Unable to delete release scope.";
            return;
        }

        await Refresh();
    }
}
