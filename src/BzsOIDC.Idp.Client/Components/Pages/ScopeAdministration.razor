@page "/admin/scopes"
@using BzsOIDC.Idp.Client.Services.Scopes
@inject IScopesClient Scopes

<PageTitle>Scopes</PageTitle>
<AuthorizeView>
    <Authorized>
        <section class="admin-page">
            <header class="page-header">
                <div class="page-header__titles">
                    <h1>Scopes</h1>
                    <p class="page-subtitle">Define the scopes clients can request and the resources they release.</p>
                </div>
                <div class="page-header__actions">
                    <button class="btn btn--ghost" type="button" @onclick="Refresh">Refresh</button>
                    <button class="btn btn--primary" type="button" @onclick="BeginCreate">New scope</button>
                </div>
            </header>

            <div class="toolbar">
                <div class="toolbar__search">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                        <path d="m21 21-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <input aria-label="Search scopes" @bind="_search" @bind:event="oninput" placeholder="Search scopes" />
                </div>
            </div>

            @if (_model is null)
            {
                <p class="loading-note" role="status" aria-live="polite">Loading…</p>
            }
            else
            {
                <div class="admin-card admin-card--table">
                    <table class="data-table" data-testid="scopes-table">
                        <thead><tr><th>Name</th><th>Display name</th><th>Resources</th><th>Protected resources</th><th>Permissions</th><th class="data-table__actions-col"></th></tr></thead>
                        <tbody>
                            @foreach (var item in _model.Items)
                            {
                                <tr>
                                    <td><code class="data-table__code">@item.Name</code></td>
                                    <td><span class="data-table__primary">@item.DisplayName</span></td>
                                    <td class="data-table__muted">@string.Join(", ", item.Resources)</td>
                                    <td class="data-table__muted">@string.Join(", ", item.Clients)</td>
                                    <td class="data-table__muted">@string.Join(", ", item.Permissions)</td>
                                    <td class="data-table__actions">
                                        <button class="btn btn--ghost btn--small" type="button" @onclick="() => BeginEdit(item)">Edit</button>
                                        @if (!item.IsReserved)
                                        {
                                            <button class="btn btn--danger-ghost btn--small" type="button" @onclick="() => DeleteAsync(item)">Delete</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <p class="table-summary">Showing @_model.Items.Count of @_model.TotalCount</p>
            }

            @if (_editor is not null)
            {
                <section class="editor-card" aria-label="Scope editor">
                    <h2 class="editor-card__title">@(_editing ? "Edit scope" : "New scope")</h2>
                    <div class="field-grid">
                        <label class="field"><span class="field__label">Name</span><input @bind="_editor.Name" disabled="@_editing" /></label>
                        <label class="field"><span class="field__label">Display name</span><input @bind="_editor.DisplayName" /></label>
                        <label class="field field--span"><span class="field__label">Description</span><textarea rows="3" @bind="_editor.Description"></textarea></label>
                        <label class="field field--span"><span class="field__label">Resources</span><input @bind="_resourcesText" /></label>
                    </div>
                    <div class="editor-card__actions">
                        <button class="btn btn--primary" type="button" @onclick="Save">Save</button>
                        <button class="btn btn--ghost" type="button" @onclick="Cancel">Cancel</button>
                    </div>
                    @if (!string.IsNullOrEmpty(_error))
                    {
                        <div class="alert alert--error" role="alert">@_error</div>
                    }
                </section>
            }
        </section>
    </Authorized>
    <NotAuthorized><p class="loading-note">Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private OidcScopeListResponse? _model;
    private string _search = string.Empty;
    private OidcScopeUpsertRequest? _editor;
    private string _resourcesText = string.Empty;
    private string? _etag;
    private string? _error;
    private bool _editing;

    protected override async Task OnInitializedAsync() => await Refresh();
    private async Task Refresh() => _model = await Scopes.ListAsync(_search);
    private void BeginCreate() { _editing = false; _etag = null; _editor = new(); _resourcesText = string.Empty; _error = null; }
    private void BeginEdit(OidcScopeResponse item) { _editing = true; _etag = item.ETag; _editor = new() { Name = item.Name, DisplayName = item.DisplayName, Description = item.Description, Resources = item.Resources }; _resourcesText = string.Join(", ", item.Resources); _error = null; }
    private void Cancel() => _editor = null;
    private async Task Save()
    {
        if (_editor is null || string.IsNullOrWhiteSpace(_editor.Name)) { _error = "Name is required."; return; }
        var request = new OidcScopeUpsertRequest { Name = _editor.Name.Trim(), DisplayName = _editor.DisplayName, Description = _editor.Description, Resources = _resourcesText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries) };
        using var response = _editing ? await Scopes.UpdateAsync(request.Name!, request, _etag ?? string.Empty) : await Scopes.CreateAsync(request);
        if (!response.IsSuccessStatusCode) { _error = response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed ? "The scope changed. Reload and try again." : "Unable to save scope."; return; }
        _editor = null; await Refresh();
    }

    private async Task DeleteAsync(OidcScopeResponse item)
    {
        if (item.IsReserved)
        {
            _error = "Reserved release scopes cannot be deleted.";
            return;
        }

        _error = null;
        using var response = await Scopes.DeleteAsync(item.Name, item.ETag);
        if (response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed)
        {
            _error = "The release scope changed. Reload and try again.";
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            _error = response.StatusCode == System.Net.HttpStatusCode.Conflict
                ? "The release scope is still referenced and cannot be deleted."
                : "Unable to delete release scope.";
            return;
        }

        await Refresh();
    }
}
