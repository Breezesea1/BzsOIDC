@page "/admin/roles"
@using BzsOIDC.Idp.Client.Services.Permissions
@inject IPermissionTopologyClient RolesClient

<PageTitle>Role administration</PageTitle>
<AuthorizeView>
    <Authorized>
        <section class="admin-page" data-testid="roles-page">
            <header class="page-header">
                <div class="page-header__titles">
                    <h1>Role administration</h1>
                    <p class="page-subtitle">Group permissions into roles and assign them to users.</p>
                </div>
                <button class="btn btn--primary" type="button" @onclick="BeginCreate">New Role</button>
            </header>

            <div class="toolbar">
                <div class="toolbar__search">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2" />
                        <path d="m21 21-4.3-4.3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    </svg>
                    <input aria-label="Search roles" @bind="_search" @bind:event="oninput" @onchange="ReloadAsync" placeholder="Search roles" />
                </div>
            </div>

            @if (_loading)
            {
                <p class="loading-note" role="status" aria-live="polite">Loading…</p>
            }

            @if (_error is not null)
            {
                <div class="alert alert--error" role="alert">@_error</div>
            }

            <div class="split-view">
                <div class="admin-card role-list-card">
                    <ul class="role-list">
                        @foreach (var role in _roles)
                        {
                            <li class="role-list__item @(_selected?.Id == role.Id && !_creating ? "is-active" : string.Empty)">
                                <button class="role-list__select" type="button" aria-pressed="@(_selected?.Id == role.Id && !_creating)" @onclick="() => SelectAsync(role)">
                                    <span class="role-list__name">@role.Name</span>
                                    <span class="role-list__meta">@role.PermissionCount permissions</span>
                                </button>
                                @if (role.IsProtected)
                                {
                                    <span class="badge badge--neutral">protected</span>
                                }
                                else
                                {
                                    <button class="btn btn--danger-ghost btn--small" type="button" @onclick="() => DeleteAsync(role)">Delete</button>
                                }
                            </li>
                        }
                    </ul>
                </div>

                @if (_selected is not null)
                {
                    <div class="editor-card role-editor">
                        <h2 class="editor-card__title">@(_creating ? "New role" : _selected.Name)</h2>
                        <label class="field"><span class="field__label">Role name</span><input @bind="_name" disabled="@_selected.IsProtected" /></label>
                        <div class="editor-card__actions">
                            <button class="btn btn--primary" type="button" @onclick="SaveAsync" disabled="@(_selected.IsProtected && !_creating)">Save</button>
                        </div>
                        @if (!_creating)
                        {
                            <fieldset class="permission-fieldset" aria-label="Permission assignment">
                                <legend>Permission assignment</legend>
                                <div class="permission-grid">
                                    @foreach (var permission in _allPermissions)
                                    {
                                        <label class="permission-chip"><input type="checkbox" checked="@_selectedPermissions.Contains(permission)" @onchange="eventArgs => TogglePermission(permission, eventArgs)" disabled="@_selected.IsProtected" /> <span>@permission</span></label>
                                    }
                                </div>
                                <div class="editor-card__actions">
                                    <button class="btn btn--secondary" type="button" @onclick="SyncPermissionsAsync" disabled="@_selected.IsProtected">Save permissions</button>
                                </div>
                            </fieldset>
                        }
                        @if (_conflict)
                        {
                            <div class="alert alert--warning" role="alert">This role changed elsewhere. Reload to continue; your edits are preserved.</div>
                        }
                    </div>
                }
            </div>
        </section>
    </Authorized>
    <NotAuthorized><p class="loading-note">Sign in to continue.</p></NotAuthorized>
</AuthorizeView>

@code {
    private IReadOnlyList<RoleResponse> _roles = [];
    private RoleResponse? _selected;
    private string _search = string.Empty;
    private string _name = string.Empty;
    private string? _error;
    private bool _loading;
    private bool _conflict;
    private bool _creating;
    private IReadOnlyList<string> _allPermissions = [];
    private HashSet<string> _selectedPermissions = new(StringComparer.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => ReloadAsync();
    private async Task ReloadAsync()
    {
        _loading = true;
        try { var result = await RolesClient.ListRolesAsync(_search); _roles = result?.Items ?? []; _error = null; }
        catch (Exception ex) { _error = ex.Message; }
        finally { _loading = false; }
    }
    private async Task SelectAsync(RoleResponse role)
    {
        _selected = await RolesClient.GetRoleAsync(role.Id) ?? role;
        _name = _selected.Name;
        _creating = false;
        _conflict = false;
        _selectedPermissions = new HashSet<string>(await RolesClient.GetRolePermissionsAsync(_selected.Id) ?? [], StringComparer.OrdinalIgnoreCase);
        var resources = await RolesClient.GetResourcesAsync() ?? [];
        _allPermissions = resources.SelectMany(resource => resource.Permissions).Select(permission => permission.Name).Distinct(StringComparer.OrdinalIgnoreCase).Order().ToArray();
    }

    private void BeginCreate()
    {
        _selected = new RoleResponse(Guid.Empty, string.Empty, string.Empty, false, 0, [], string.Empty);
        _name = string.Empty;
        _creating = true;
        _selectedPermissions.Clear();
        _conflict = false;
        _error = null;
    }
    private async Task SaveAsync()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_name)) { _error = "Role name is required."; return; }
        if (_creating)
        {
            using var createResponse = await RolesClient.CreateRoleAsync(new RoleUpsertRequest(_name.Trim()));
            if (!createResponse.IsSuccessStatusCode) { _error = $"Request failed ({(int)createResponse.StatusCode})."; return; }
            _selected = null;
            _creating = false;
            await ReloadAsync();
            return;
        }
        using var response = await RolesClient.UpdateRoleAsync(_selected.Id, new RoleUpsertRequest(_name), _selected.ETag);
        if (response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed) { _conflict = true; return; }
        if (!response.IsSuccessStatusCode) { _error = $"Request failed ({(int)response.StatusCode})."; return; }
        _conflict = false; await ReloadAsync(); await SelectAsync(_selected);
    }

    private async Task DeleteAsync(RoleResponse role)
    {
        if (role.IsProtected) { _error = "Protected Roles cannot be deleted."; return; }
        using var response = await RolesClient.DeleteRoleAsync(role.Id, role.ETag);
        if (response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed) { _error = "This Role changed elsewhere. Reload and try again."; return; }
        if (!response.IsSuccessStatusCode) { _error = $"Request failed ({(int)response.StatusCode})."; return; }
        if (_selected?.Id == role.Id) _selected = null;
        await ReloadAsync();
    }

    private void TogglePermission(string permission, ChangeEventArgs args)
    {
        if (args.Value is bool selected && selected) _selectedPermissions.Add(permission);
        else _selectedPermissions.Remove(permission);
    }

    private async Task SyncPermissionsAsync()
    {
        if (_selected is null || _creating) return;
        using var response = await RolesClient.SyncRolePermissionsAsync(_selected.Id, new RolePermissionSyncRequest(_selectedPermissions.Order(StringComparer.OrdinalIgnoreCase).ToArray()), _selected.ETag);
        if (response.StatusCode == System.Net.HttpStatusCode.PreconditionFailed) { _conflict = true; return; }
        if (!response.IsSuccessStatusCode) { _error = $"Request failed ({(int)response.StatusCode})."; return; }
        _conflict = false;
        await SelectAsync(_selected);
    }
}
