@page "/account/denied"
@layout AuthLayout
@inject NavigationManager Navigation

<PageTitle>Access denied</PageTitle>
<section class="auth-card auth-card--center denied-page" data-testid="wasm-denied">
    <div class="auth-emblem auth-emblem--warn" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
            <path d="M9.5 9.5l5 5M14.5 9.5l-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </div>
    <h1>Access denied</h1>
    <p class="auth-card__lead">Your account is signed in, but it does not have permission to view this resource.</p>
    <div class="auth-action-row">
        <a class="auth-secondary" href="@HomeHref">Return home</a>
        <a class="auth-submit auth-submit--link" href="@LoginHref">Switch account</a>
    </div>
</section>

@code {
    private string ClientPath(string path)
    {
        var basePath = new Uri(Navigation.BaseUri, UriKind.Absolute).AbsolutePath.TrimEnd('/');
        return string.IsNullOrEmpty(path)
            ? (string.IsNullOrEmpty(basePath) ? "/" : $"{basePath}/")
            : (string.IsNullOrEmpty(basePath) ? $"/{path}" : $"{basePath}/{path}");
    }

    private string HomeHref => ClientPath(string.Empty);
    private string LoginHref => ClientPath("login");
}
