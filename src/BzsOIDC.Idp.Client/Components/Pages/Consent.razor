@page "/consent"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject IAntiforgeryTokenStore Antiforgery
@inject NavigationManager Navigation

<PageTitle>Authorize application</PageTitle>
<section class="auth-card consent-card" aria-labelledby="consent-heading">
    @if (_loading)
    {
        <p class="auth-status" role="status" aria-live="polite" aria-atomic="true">Loading authorization request…</p>
    }
    else if (_error is not null)
    {
        <div class="auth-alert" role="alert" aria-live="assertive">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 8v4M12 16h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span>@_error</span>
        </div>
    }
    else if (_preview is not null)
    {
        <div class="auth-emblem" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                <path d="M12 3l8 4v5c0 5-3.4 8.4-8 9-4.6-.6-8-4-8-9V7l8-4Z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                <path d="M9 12l2 2 4-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
        </div>
        <header class="auth-card__header">
            <h1 id="consent-heading">Allow <strong class="consent-app-name">@_preview.DisplayName</strong> to access your account?</h1>
            <p>The application is requesting the following scopes.</p>
        </header>

        <ul class="consent-scope-list">
            @foreach (var scope in _preview.Scopes)
            {
                <li>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M20 6 9 17l-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                    <span class="consent-scope__body">
                        <strong>@(scope.DisplayName ?? scope.Name)</strong>
                        @if (!string.IsNullOrWhiteSpace(scope.Description))
                        {
                            <span class="consent-scope__description">@scope.Description</span>
                        }
                    </span>
                </li>
            }
        </ul>

        <form method="post" action="@_preview.AuthorizeUrl" class="consent-actions">
            <input type="hidden" name="@_antiforgery.FormFieldName" value="@_antiforgery.Token" />
            @foreach (var parameter in GetProtocolParameters())
            {
                <input type="hidden" name="@parameter.Name" value="@parameter.Value" />
            }
            <input type="hidden" name="consent_request" value="@_preview.RequestToken" />
            <button class="auth-submit" type="submit" name="consent" value="accept">Allow access</button>
            <button class="auth-secondary" type="submit" name="consent" value="deny">Deny</button>
        </form>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "request")] public string? RequestToken { get; set; }

    private OidcConsentPreviewResponse? _preview;
    private AntiforgeryTokenResponse _antiforgery = new();
    private string? _error;
    private bool _loading = true;

    private IEnumerable<ProtocolParameter> GetProtocolParameters()
    {
        if (_preview is null || !Uri.TryCreate(_preview.AuthorizeUrl, UriKind.RelativeOrAbsolute, out var authorizeUri))
        {
            yield break;
        }

        if (!authorizeUri.IsAbsoluteUri)
        {
            authorizeUri = new Uri(new Uri("https://localhost"), authorizeUri);
        }

        foreach (var pair in QueryHelpers.ParseQuery(authorizeUri.Query))
        {
            if (string.Equals(pair.Key, "consent_request", StringComparison.OrdinalIgnoreCase))
            {
                continue;
            }

            foreach (var value in pair.Value)
            {
                yield return new ProtocolParameter(pair.Key, value ?? string.Empty);
            }
        }
    }

    private sealed record ProtocolParameter(string Name, string Value);

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(RequestToken))
        {
            _error = "The authorization request is invalid.";
            _loading = false;
            return;
        }

        try
        {
            using var client = ApiClients.CreateClient();
            _preview = await client.GetFromJsonAsync<OidcConsentPreviewResponse>(
                $"/api/oidc/consent-preview?request={Uri.EscapeDataString(RequestToken)}");
            _antiforgery = await Antiforgery.GetOrRefreshAsync();
            if (_preview is null)
            {
                _error = "The authorization request is invalid.";
            }
        }
        catch (HttpRequestException)
        {
            _error = "The authorization request is invalid.";
        }
        finally
        {
            _loading = false;
        }
    }
}
