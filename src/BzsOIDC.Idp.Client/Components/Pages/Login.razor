@page "/login"
@layout AuthLayout
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject NavigationManager Navigation
@inject IAntiforgeryTokenStore Antiforgery
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IStringLocalizer<Login> L

<PageTitle>@L["PageTitle"]</PageTitle>
<section class="auth-card" aria-labelledby="login-heading">
    <header class="auth-card__header">
        <h1 id="login-heading">@L["Heading"]</h1>
        <p>@L["Subtitle"]</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div id="login-error" class="auth-alert" role="alert" aria-live="assertive">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 8v4M12 16h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span>@_error</span>
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" aria-busy="@_busy" class="auth-form">
        <DataAnnotationsValidator />
        <div class="auth-field">
            <label for="username">@L["Username"]</label>
            <input id="username" @bind="_model.UserName" @bind:event="oninput" autocomplete="username" aria-describedby="@(_error is null ? null : "login-error")" />
        </div>
        <div class="auth-field">
            <label for="password">@L["Password"]</label>
            <input id="password" type="password" @bind="_model.Password" @bind:event="oninput" autocomplete="current-password" aria-describedby="@(_error is null ? null : "login-error")" />
        </div>
        <div class="auth-row">
            <label class="auth-remember"><InputCheckbox @bind-Value="_model.RememberMe" /> @L["RememberMe"]</label>
        </div>
        <button class="auth-submit" type="submit" disabled="@_busy" aria-describedby="login-status">
            <span class="auth-submit__spinner" aria-hidden="true"></span>
            <span>@(_busy ? L["Submitting"] : L["Submit"])</span>
        </button>
        <span id="login-status" class="auth-status" role="status" aria-live="polite" aria-atomic="true">@(_busy ? L["Submitting"].Value : string.Empty)</span>
    </EditForm>

    @if (_providers.Count > 0)
    {
        <div class="auth-divider" role="separator"><span>@L["ExternalDivider"]</span></div>
        <div class="auth-external-list">
            @foreach (var provider in _providers)
            {
                <a class="auth-external" href="@BuildExternalHref(provider.RouteSegment)">@L["ContinueWith", provider.DisplayName]</a>
            }
        </div>
    }

    <p class="auth-switch">@L["NoAccount"] <a href="@BuildRegisterHref()">@L["CreateAccount"]</a></p>
</section>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private IReadOnlyList<ExternalLoginProviderResponse> _providers = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (authenticationState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo(ToClientPath(ReturnUrl), forceLoad: true);
            return;
        }

        try
        {
            using var client = ApiClients.CreateClient();
            var response = await client.GetAsync("/api/account/external/providers");
            if (response.IsSuccessStatusCode)
            {
                _providers = await response.Content.ReadFromJsonAsync<ExternalLoginProviderResponse[]>() ?? [];
            }
        }
        catch (HttpRequestException)
        {
            _providers = [];
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            using var client = ApiClients.CreateClient();
            var request = new LoginRequest(_model.UserName, _model.Password, _model.RememberMe, ReturnUrl);
            using var response = await client.PostAsJsonAsync("/api/account/login", request);
            if (response.IsSuccessStatusCode)
            {
                Antiforgery.Clear();
                try
                {
                    var module = await JS.InvokeAsync<IJSObjectReference>("import", "./session-sync.js");
                    await module.InvokeVoidAsync("publishSession", "login");
                    await module.DisposeAsync();
                }
                catch (JSException)
                {
                }
                var result = await response.Content.ReadFromJsonAsync<AccountActionResponse>();
                Navigation.NavigateTo(ToClientPath(result?.RedirectUri), forceLoad: true);
                return;
            }

            var problem = await ApiProblemDetailsMapper.ReadAsync(response);
            _error = problem?.Code == ApiErrorCodes.InvalidCredentials ? L["InvalidCredentials"].Value : L["GenericError"].Value;
        }
        catch (HttpRequestException)
        {
            _error = L["GenericError"].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildExternalHref(string provider) =>
        QueryHelpers.AddQueryString($"/api/account/external/{Uri.EscapeDataString(provider)}", "returnUrl", ReturnUrl ?? "/");

    private string BuildRegisterHref() => string.IsNullOrWhiteSpace(ReturnUrl)
        ? ToClientPath("/register")
        : QueryHelpers.AddQueryString(ToClientPath("/register"), "returnUrl", ReturnUrl);

    private string ToClientPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path) || path == "/")
        {
            return "/";
        }

        return path.StartsWith('/') ? path : $"/{path}";
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
