@page "/login"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject NavigationManager Navigation
@inject IAntiforgeryTokenStore Antiforgery
@inject IJSRuntime JS

<PageTitle>Sign in</PageTitle>
<main class="auth-page" aria-labelledby="login-heading">
    <h1 id="login-heading">Sign in</h1>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div id="login-error" role="alert" aria-live="assertive">@_error</div>
    }
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" aria-busy="@_busy">
        <DataAnnotationsValidator />
        <label for="username">Username</label>
        <InputText id="username" @bind-Value="_model.UserName" autocomplete="username" aria-describedby="login-error" />
        <label for="password">Password</label>
        <InputText id="password" type="password" @bind-Value="_model.Password" autocomplete="current-password" aria-describedby="login-error" />
        <label><InputCheckbox @bind-Value="_model.RememberMe" /> Remember me</label>
        <button type="submit" disabled="@_busy" aria-describedby="login-status">@(_busy ? "Signing in…" : "Sign in")</button>
        <span id="login-status" role="status" aria-live="polite" aria-atomic="true">@(_busy ? "Signing in…" : string.Empty)</span>
    </EditForm>
    @foreach (var provider in _providers)
    {
        <a href="@BuildExternalHref(provider.RouteSegment)">Continue with @provider.DisplayName</a>
    }
    <p><a href="@BuildRegisterHref()">Create an account</a></p>
</main>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginModel _model = new();
    private IReadOnlyList<ExternalLoginProviderResponse> _providers = [];
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var client = ApiClients.CreateClient();
            var response = await client.GetAsync("/api/account/external/providers");
            if (response.IsSuccessStatusCode)
            {
                _providers = await response.Content.ReadFromJsonAsync<ExternalLoginProviderResponse[]>() ?? [];
            }
        }
        catch (HttpRequestException)
        {
            _providers = [];
        }
    }

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            using var client = ApiClients.CreateClient();
            var request = new LoginRequest(_model.UserName, _model.Password, _model.RememberMe, ReturnUrl);
            using var response = await client.PostAsJsonAsync("/api/account/login", request);
            if (response.IsSuccessStatusCode)
            {
                Antiforgery.Clear();
                try
                {
                    var module = await JS.InvokeAsync<IJSObjectReference>("import", "./session-sync.js");
                    await module.InvokeVoidAsync("publishSession", "login");
                    await module.DisposeAsync();
                }
                catch (JSException)
                {
                }
                var result = await response.Content.ReadFromJsonAsync<AccountActionResponse>();
                Navigation.NavigateTo(ToClientPath(result?.RedirectUri), forceLoad: true);
                return;
            }

            var problem = await ApiProblemDetailsMapper.ReadAsync(response);
            _error = problem?.Code == ApiErrorCodes.InvalidCredentials ? "Invalid credentials." : "Unable to sign in.";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to sign in.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildExternalHref(string provider) =>
        QueryHelpers.AddQueryString($"/api/account/external/{Uri.EscapeDataString(provider)}", "returnUrl", ReturnUrl ?? "/");

    private string BuildRegisterHref() => string.IsNullOrWhiteSpace(ReturnUrl)
        ? ToClientPath("/register")
        : QueryHelpers.AddQueryString(ToClientPath("/register"), "returnUrl", ReturnUrl);

    private string ToClientPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path) || path == "/")
        {
            return "/";
        }

        return path.StartsWith('/') ? path : $"/{path}";
    }

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}
