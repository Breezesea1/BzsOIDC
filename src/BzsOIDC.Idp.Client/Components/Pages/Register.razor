@page "/register"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject NavigationManager Navigation
@inject IStringLocalizer<Register> L

<PageTitle>@L["PageTitle"]</PageTitle>
<section class="auth-card" aria-labelledby="register-heading">
    <header class="auth-card__header">
        <h1 id="register-heading">@L["Heading"]</h1>
        <p>@L["Subtitle"]</p>
    </header>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div id="register-error" class="auth-alert" role="alert" aria-live="assertive">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 8v4M12 16h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span>@_error</span>
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="SubmitAsync" aria-busy="@_busy" class="auth-form">
        <DataAnnotationsValidator />
        <div class="auth-field">
            <label for="register-username">@L["Username"]</label>
            <InputText id="register-username" @bind-Value="_model.UserName" autocomplete="username" aria-describedby="@(_error is null ? null : "register-error")" />
        </div>
        <div class="auth-field">
            <label for="register-email">@L["Email"]</label>
            <InputText id="register-email" @bind-Value="_model.Email" autocomplete="email" aria-describedby="@(_error is null ? null : "register-error")" />
        </div>
        <div class="auth-field">
            <label for="register-password">@L["Password"]</label>
            <InputText id="register-password" type="password" @bind-Value="_model.Password" autocomplete="new-password" aria-describedby="@(_error is null ? null : "register-error")" />
        </div>
        <div class="auth-field">
            <label for="register-confirm-password">@L["ConfirmPassword"]</label>
            <InputText id="register-confirm-password" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" aria-describedby="@(_error is null ? null : "register-error")" />
        </div>
        <button class="auth-submit" type="submit" disabled="@_busy" aria-describedby="register-status">
            <span class="auth-submit__spinner" aria-hidden="true"></span>
            <span>@(_busy ? L["Submitting"] : L["Submit"])</span>
        </button>
        <span id="register-status" class="auth-status" role="status" aria-live="polite" aria-atomic="true">@(_busy ? L["Submitting"].Value : string.Empty)</span>
    </EditForm>

    <p class="auth-switch">@L["HaveAccount"] <a href="@BuildLoginHref()">@L["SignIn"]</a></p>
</section>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly RegisterModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            using var client = ApiClients.CreateClient();
            var request = new RegisterRequest(_model.UserName, _model.Email, _model.Password, _model.ConfirmPassword, ReturnUrl);
            using var response = await client.PostAsJsonAsync("/api/account/register", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AccountActionResponse>();
                Navigation.NavigateTo(result?.RedirectUri ?? "/", forceLoad: true);
                return;
            }

            var problem = await ApiProblemDetailsMapper.ReadAsync(response);
            _error = problem?.Code == ApiErrorCodes.ValidationFailed ? L["ValidationError"].Value : L["GenericError"].Value;
        }
        catch (HttpRequestException)
        {
            _error = L["GenericError"].Value;
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildLoginHref() => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/login"
        : QueryHelpers.AddQueryString("/login", "returnUrl", ReturnUrl);

    private sealed class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
