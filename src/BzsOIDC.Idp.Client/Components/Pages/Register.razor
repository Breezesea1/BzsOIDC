@page "/register"
@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject NavigationManager Navigation

<PageTitle>Create account</PageTitle>
<main class="auth-page" aria-labelledby="register-heading">
    <h1 id="register-heading">Create account</h1>
    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div id="register-error" role="alert" aria-live="assertive">@_error</div>
    }
    <EditForm Model="_model" OnValidSubmit="SubmitAsync" aria-busy="@_busy">
        <DataAnnotationsValidator />
        <label for="register-username">Username</label>
        <InputText id="register-username" @bind-Value="_model.UserName" autocomplete="username" aria-describedby="register-error" />
        <label for="register-email">Email</label>
        <InputText id="register-email" @bind-Value="_model.Email" autocomplete="email" aria-describedby="register-error" />
        <label for="register-password">Password</label>
        <InputText id="register-password" type="password" @bind-Value="_model.Password" autocomplete="new-password" aria-describedby="register-error" />
        <label for="register-confirm-password">Confirm password</label>
        <InputText id="register-confirm-password" type="password" @bind-Value="_model.ConfirmPassword" autocomplete="new-password" aria-describedby="register-error" />
        <button type="submit" disabled="@_busy" aria-describedby="register-status">@(_busy ? "Creating account…" : "Create account")</button>
        <span id="register-status" role="status" aria-live="polite" aria-atomic="true">@(_busy ? "Creating account…" : string.Empty)</span>
    </EditForm>
    <p><a href="@BuildLoginHref()">Sign in</a></p>
</main>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly RegisterModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            using var client = ApiClients.CreateClient();
            var request = new RegisterRequest(_model.UserName, _model.Email, _model.Password, _model.ConfirmPassword, ReturnUrl);
            using var response = await client.PostAsJsonAsync("/api/account/register", request);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<AccountActionResponse>();
                Navigation.NavigateTo(result?.RedirectUri ?? "/", forceLoad: true);
                return;
            }

            var problem = await ApiProblemDetailsMapper.ReadAsync(response);
            _error = problem?.Code == ApiErrorCodes.ValidationFailed ? "Check the entered values." : "Unable to create account.";
        }
        catch (HttpRequestException)
        {
            _error = "Unable to create account.";
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildLoginHref() => string.IsNullOrWhiteSpace(ReturnUrl)
        ? "/login"
        : QueryHelpers.AddQueryString("/login", "returnUrl", ReturnUrl);

    private sealed class RegisterModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
