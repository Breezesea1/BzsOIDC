@page "/Error"
@layout AuthLayout
@using System.Diagnostics
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Error> L

<PageTitle>@L["PageTitle"]</PageTitle>

<section class="auth-card status-card" aria-labelledby="error-heading">
    <div class="status-card__main">
        <span class="status-card__kicker">@L["StatusKicker"]</span>
        <div class="status-card__code" aria-hidden="true">500</div>
        <h1 id="error-heading">@L["Heading"]</h1>
        <p class="auth-card__lead">@L["Subheading"]</p>
        <div class="auth-action-row">
            <a class="auth-submit auth-submit--link" href="/login" data-enhance-nav="false">
                <span>@L["ErrorPrimaryAction"]</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
                    <path d="m12 5 7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </a>
            <a class="auth-secondary" href="/">@L["ErrorSecondaryAction"]</a>
        </div>
    </div>

    <aside class="status-card__aside" aria-label="@L["TechnicalDetailsAria"]">
        <p class="status-card__aside-label">@L["TechnicalDetailsHeading"]</p>
        <p class="status-card__aside-copy">@L["TechnicalDetailsLead"]</p>

        @if (ShowRequestId)
        {
            <div class="status-card__request-id">
                <span class="status-card__request-label">@L["RequestIdLabel"]</span>
                <code>@RequestId</code>
            </div>
        }

        <p class="status-card__tip">
            <strong>@L["DevelopmentModeHeading"]</strong>
            <span>@DevelopmentModeIntroMarkup</span>
            <span>@L["DevelopmentModeWarning"] @DevelopmentModeDetailsMarkup</span>
        </p>
    </aside>
</section>

@code {
    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    private MarkupString DevelopmentModeIntroMarkup =>
        new(string.Format(L["DevelopmentModeIntroHtml"].Value, BoldText(L["DevelopmentModeName"])));

    private MarkupString DevelopmentModeDetailsMarkup =>
        new(string.Format(
            L["DevelopmentModeDetailsHtml"].Value,
            BoldText("ASPNETCORE_ENVIRONMENT"),
            BoldText(L["DevelopmentModeName"])));

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id;

    private static string BoldText(string text) =>
        $"<strong>{text}</strong>";

}
