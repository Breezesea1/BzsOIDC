@page "/logout"
@layout AuthLayout
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using BzsOIDC.Contracts
@using BzsOIDC.Idp.Client.Services.Session
@inject IApiHttpClientFactory ApiClients
@inject IAntiforgeryTokenStore Antiforgery
@inject SessionAuthenticationStateProvider Session
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IStringLocalizer<Logout> L

<PageTitle>@L["PageTitle"]</PageTitle>
<section class="auth-card auth-card--center logout-page" data-testid="wasm-logout" aria-labelledby="logout-heading">
    <div class="auth-emblem auth-emblem--warn" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
            <path d="M15 3h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-2" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M10 17l5-5-5-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            <path d="M15 12H3" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
    </div>
    <h1 id="logout-heading">@L["Heading"]</h1>
    <p class="auth-card__lead">@L["Prompt"]</p>

    @if (_error is not null)
    {
        <div id="logout-error" class="auth-alert" role="alert" aria-live="assertive">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2" />
                <path d="M12 8v4M12 16h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            <span>@L["Error"]</span>
        </div>
    }

    <button class="auth-submit auth-submit--danger" type="button" disabled="@_busy" aria-describedby="logout-status" @onclick="LogoutAsync">
        <span class="auth-submit__spinner" aria-hidden="true"></span>
        <span>@(_busy ? L["Submitting"] : L["Submit"])</span>
    </button>
    <span id="logout-status" class="auth-status" role="status" aria-live="polite" aria-atomic="true">@(_busy ? L["Submitting"].Value : string.Empty)</span>
    <a class="auth-cancel" href="@BuildReturnUrl()">@L["Cancel"]</a>
</section>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _busy;
    private string? _error;

    private async Task LogoutAsync()
    {
        if (_busy)
        {
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            using var client = ApiClients.CreateClient();
            using var response = await client.PostAsJsonAsync("/api/account/logout", new LogoutRequest(ReturnUrl));
            if (!response.IsSuccessStatusCode)
            {
                _error = "logout_failed";
                return;
            }

            Antiforgery.Clear();
            Session.Invalidate();
            try
            {
                var module = await JS.InvokeAsync<IJSObjectReference>("import", "./session-sync.js");
                await module.InvokeVoidAsync("publishSession", "logout");
                await module.DisposeAsync();
            }
            catch (JSException)
            {
                // Session invalidation and navigation remain authoritative if sync is unavailable.
            }

            var result = await response.Content.ReadFromJsonAsync<AccountActionResponse>();
            Navigation.NavigateTo(ToClientPath(result?.RedirectUri), forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _error = "logout_failed";
        }
        finally
        {
            _busy = false;
        }
    }

    private string BuildReturnUrl() => string.IsNullOrWhiteSpace(ReturnUrl) || !ReturnUrl.StartsWith('/')
        ? "/"
        : ToClientPath(ReturnUrl);

    private static string ToClientPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path) || path == "/") return "/";
        return path.StartsWith('/') ? path : $"/{path}";
    }
}
