@using Microsoft.AspNetCore.Components.Authorization
@using BzsOIDC.Idp.Client.Components.Pages

<BzsThemeProvider Mode="BzsThemeMode.System" Density="BzsDensity.Compact">
    <CascadingAuthenticationState>
        <Router AppAssembly="typeof(App).Assembly"
                NotFoundPage="typeof(Components.Pages.NotFound)">
            <Found Context="routeData">
                <CascadingValue Value="routeData">
                    <RouteView RouteData="routeData" DefaultLayout="typeof(Components.Layout.WasmLayout)" />
                    <FocusOnNavigate RouteData="routeData" Selector="h1" />
                </CascadingValue>
            </Found>
            <NotFound>
                <LayoutView Layout="typeof(Components.Layout.WasmLayout)">
                    <NotFound />
                </LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>

    <BzsOverlayHost />
    <SessionSyncHost />
</BzsThemeProvider>
