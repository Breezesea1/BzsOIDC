@page "/admin/users"
@rendermode InteractiveServer
@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using BootstrapBlazor.Components
@using BzsOIDC.Idp.Services.Identity
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject NavigationManager NavigationManager
@inject IUserAdministration UserAdministration
@inject IStringLocalizer<UserManagement> L
@layout BzsOIDC.Idp.Client.Components.Layout.MainLayout

<PageTitle>@L["PageTitle"]</PageTitle>

@if (!_hasAccess)
{
    <div class="admin-loading-shell">
        <div class="admin-loading-card">
            <span class="admin-loading-kicker">@L["AdminArea"]</span>
            <h1>@L["CheckingAccess"]</h1>
            <p>@L["CheckingAccessLead"]</p>
        </div>
    </div>
}
else
{
    <section class="admin-page-shell admin-users-page-shell">
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="admin-feedback @(_statusIsError ? "is-error" : "is-success")" role="status" aria-live="polite">@_statusMessage</div>
        }

        <div class="admin-grid-toolbar admin-users-command-bar">
            <div class="admin-filter-tabs admin-users-filter-tabs" role="group" aria-label='@L["FilterByRole"]'>
                <button type="button" aria-pressed="@(_roleFilter == null)" class="admin-filter-tab @(_roleFilter == null ? "is-active" : "")" @onclick='() => SetRoleFilter(null)'>
                    @L["All"] <span class="admin-tab-count">@_users.Count</span>
                </button>
                <button type="button" aria-pressed="@(_roleFilter == true)" class="admin-filter-tab @(_roleFilter == true ? "is-active" : "")" @onclick='() => SetRoleFilter(true)'>
                    @L["Admin"] <span class="admin-tab-count">@AdminCount</span>
                </button>
                <button type="button" aria-pressed="@(_roleFilter == false)" class="admin-filter-tab @(_roleFilter == false ? "is-active" : "")" @onclick='() => SetRoleFilter(false)'>
                    @L["Standard"] <span class="admin-tab-count">@(_users.Count - AdminCount)</span>
                </button>
            </div>

            <div class="admin-search-stack admin-users-search-stack">
                <div class="admin-search-icon-field admin-users-search-field">
                    <svg class="admin-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input id="user-search"
                            class="neo-input admin-search-input"
                            name="user-search"
                            type="search"
                            placeholder="@L["SearchPlaceholder"]"
                            value="@_searchTerm"
                            @oninput="HandleSearchInput"
                            autocomplete="off"
                            autocapitalize="off"
                            autocorrect="off"
                            spellcheck="false"
                            aria-label="@L["Search"]" />
                </div>
                <span class="admin-grid-summary">@FilteredSummary</span>
            </div>

            <div class="admin-grid-toolbar-actions admin-users-command-actions">
                @if (_selectedUsers.Count > 0)
                {
                    <span class="admin-selection-summary" data-testid="users-selection-summary">
                        @L["SelectedRows", _selectedUsers.Count]
                    </span>
                }
                <button type="button" class="admin-ghost-button admin-toolbar-button" @onclick="LoadUsersAsync" disabled="@_isBusy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12a9 9 0 0 0-15.5-6.25L3 8" />
                        <path d="M3 3v5h5" />
                        <path d="M3 12a9 9 0 0 0 15.5 6.25L21 16" />
                        <path d="M16 16h5v5" />
                    </svg>
                    @L["Refresh"]
                </button>
                <button type="button" class="admin-primary-button" @onclick="BeginCreate" disabled="@_isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    @L["NewUser"]
                </button>
            </div>
        </div>

        <div class="admin-table-shell admin-bootstrap-table" data-testid="users-table">
            <Table TItem="UserRow"
                   @ref="_table"
                   PageItems="@PageSize"
                   PageItemsSource="PageSizeOptions"
                   IsMultipleSelect="true"
                   IsKeepSelectedRows="true"
                   IsPagination="false"
                   AllowResizing="true"
                   DefaultFixedColumnWidth="200"
                   ColumnMinWidth="72"
                   ShowColumnWidthTooltip="true"
                   ShowCardView="false"
                   ShowColumnList="false"
                   ShowFilterHeader="false"
                   ShowMultiFilterHeader="false"
                   ShowFooter="false"
                   ShowEmpty="true"
                   ShowLoading="true"
                   ShowLoadingInFirstRender="true"
                   OnQueryAsync="QueryUsersAsync"
                   SelectedRows="@_selectedUsers"
                   SelectedRowsChanged="HandleSelectedRowsChanged">
                <TableColumns Context="user">
                    <TableColumn Text="@L["User"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="UserName"
                                 @bind-Field="user.UserName">
                        <Template Context="row">
                            <div class="admin-user-cell">
                                <span class="admin-avatar" aria-hidden="true">@GetInitial(row.Row.UserName)</span>
                                <div class="admin-user-text">
                                    <strong>@row.Row.UserName</strong>
                                    <span class="admin-user-meta">@(string.IsNullOrWhiteSpace(row.Row.Email) ? L["ManagedAccount"] : row.Row.Email)</span>
                                </div>
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Role"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="IsAdmin"
                                 @bind-Field="user.IsAdmin">
                        <Template Context="row">
                            <span class="admin-badge @(row.Row.IsAdmin ? "is-admin" : "is-standard")">
                                @(row.Row.IsAdmin ? L["Admin"] : L["User"])
                            </span>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Email"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="Email"
                                 @bind-Field="user.Email">
                        <Template Context="row">
                            <span class="admin-user-meta">@(string.IsNullOrWhiteSpace(row.Row.Email) ? "—" : row.Row.Email)</span>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Identifier"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="Id"
                                 @bind-Field="user.Id">
                        <Template Context="row">
                            <code class="admin-inline-code" title="@row.Row.Id">@FormatShortIdentifier(row.Row.Id)</code>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Actions"]"
                                 Filterable="false"
                                 Searchable="false"
                                 Sortable="false"
                                 @bind-Field="user.ActionKey">
                        <Template Context="row">
                            <div class="admin-actions-column">
                                <button type="button"
                                        class="admin-icon-button"
                                        title="@L["Edit"]"
                                        aria-label="@L["Edit"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => BeginEdit(row.Row)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </button>
                                <button type="button"
                                        class="admin-icon-button danger"
                                        title="@L["Delete"]"
                                        aria-label="@L["Delete"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => DeleteUserAsync(row.Row)"
                                        disabled="@(_isBusy || row.Row.Id == _currentUserId)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4h8v2" />
                                        <path d="M19 6l-1 14H6L5 6" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                    </svg>
                                </button>
                            </div>
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>

        <div class="admin-pagination-bar">
            <span class="admin-pagination-showing">@PageSummary</span>

            <div class="admin-pagination-controls">
                <label class="admin-page-size-field" for="user-page-size">
                    <span>@L["Rows"]</span>
                    <select id="user-page-size" class="neo-select admin-page-size-select" value="@PageSize" @onchange="HandlePageSizeChange">
                        @foreach (var option in PageSizeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>

                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToPreviousPage" disabled="@(!CanGoToPreviousPage)">
                    @L["PreviousPage"]
                </button>
                @for (var p = Math.Max(1, CurrentPage - 2); p <= Math.Min(TotalPages, CurrentPage + 2); p++)
                {
                    var pageNum = p;
                    <button type="button" class="admin-pagination-page-btn @(pageNum == CurrentPage ? "is-active" : "")" aria-current="@(pageNum == CurrentPage ? "page" : null)" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToNextPage" disabled="@(!CanGoToNextPage)">
                    @L["NextPage"]
                </button>
            </div>
        </div>

        <UserManagementDialog IsOpen="@_isEditorOpen"
                              IsEditing="@_isEditing"
                              IsBusy="@_isBusy"
                              UserName="@_editor.UserName"
                              UserNameChanged="HandleUserNameChanged"
                              Email="@_editor.Email"
                              EmailChanged="HandleEmailChanged"
                              Password="@_editor.Password"
                              PasswordChanged="HandlePasswordChanged"
                              IsAdmin="@_editor.IsAdmin"
                              IsAdminChanged="HandleIsAdminChanged"
                              FormErrors="@_formErrors"
                              OnClose="CloseEditor"
                              OnReset="ResetEditor"
                              OnSave="SaveAsync" />
    </section>
}

@code {
    private readonly List<UserRow> _users = [];
    private readonly List<string> _formErrors = [];
    private readonly List<UserRow> _selectedUsers = [];
    private readonly AdminCollection<UserRow, Guid> _collection = new(static user => user.Id);
    private static readonly int[] PageSizeOptions = [10, 20, 50];

    private UserEditor _editor = new();
    private Guid _currentUserId;
    private bool _hasAccess;
    private bool _isBusy;
    private bool _isEditing;
    private bool _isEditorOpen;
    private string _searchTerm = string.Empty;
    private bool? _roleFilter = null;
    private string? _statusMessage;
    private bool _statusIsError;
    private Table<UserRow>? _table;

    private int AdminCount => _users.Count(static user => user.IsAdmin);
    private int CurrentPage => _collection.CurrentPage;
    private int PageSize => _collection.PageSize;
    private bool CanGoToNextPage => CurrentPage < TotalPages;
    private bool CanGoToPreviousPage => CurrentPage > 1;
    private string FilteredSummary => _collection.TotalCount == 0
        ? L["SearchResultSummaryEmpty"].Value
        : L["SearchResultSummary", _collection.TotalCount].Value;
    private string PageSummary => _collection.TotalCount == 0
        ? L["PageSummaryEmpty"].Value
        : L["PageSummary", _collection.PageStartIndex, _collection.PageEndIndex, _collection.TotalCount].Value;
    private int TotalPages => _collection.TotalPages;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdminAccess())
        {
            return;
        }

        await LoadUsersAsync();
    }

    private bool EnsureAdminAccess()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            var loginPath = QueryHelpers.AddQueryString("/login", new Dictionary<string, string?>
            {
                ["returnUrl"] = "/admin/users",
            });

            NavigationManager.NavigateTo(loginPath, forceLoad: true);
            return false;
        }

        if (!user.IsInRole(IdentitySeedConstants.AdminRoleName))
        {
            NavigationManager.NavigateTo("/account/denied", forceLoad: true);
            return false;
        }

        _hasAccess = true;

        if (Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var currentUserId))
        {
            _currentUserId = currentUserId;
        }

        return true;
    }

    private async Task LoadUsersAsync()
    {
        _isBusy = true;

        try
        {
            _users.Clear();

            var users = await UserAdministration.GetUsersAsync();
            foreach (var user in users)
            {
                _users.Add(new UserRow
                {
                    Id = user.Id,
                    UserName = user.UserName,
                    Email = user.Email,
                    IsAdmin = user.IsAdmin,
                    ActionKey = user.Id.ToString(),
                });
            }

            _collection.ReplaceRows(_users);
            await RefreshUsersAsync(CurrentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task SetRoleFilter(bool? filter)
    {
        _roleFilter = filter;
        await RefreshUsersAsync(1);
    }

    private Task<QueryData<UserRow>> QueryUsersAsync(QueryPageOptions options)
    {
        var result = _collection.Query(CreateCollectionQuery(options));
        SyncSelectedUsers(result.SelectedItems);

        return Task.FromResult(new QueryData<UserRow>
        {
            Items = result.Items,
            TotalCount = result.TotalCount,
            IsFiltered = true,
            IsSorted = true,
            IsSearch = true,
        });
    }

    private AdminCollectionQuery<UserRow> CreateCollectionQuery(QueryPageOptions options)
    {
        var searchTerm = _searchTerm.Trim();
        var tableFilter = options.Filters.Count > 0
            ? options.ToFilterFunc<UserRow>(StringComparison.OrdinalIgnoreCase)
            : null;

        return new AdminCollectionQuery<UserRow>(
            options.PageIndex,
            PageSize,
            options.SortName,
            options.SortOrder == SortOrder.Desc,
            user =>
                (!_roleFilter.HasValue || user.IsAdmin == _roleFilter.Value) &&
                (tableFilter is null || tableFilter(user)),
            string.IsNullOrWhiteSpace(searchTerm)
                ? null
                : user => AdminTableSearch.Score(
                    searchTerm,
                    user.UserName,
                    user.Email,
                    user.Id.ToString(),
                    user.IsAdmin ? L["RoleSearchAdmin"].Value : L["RoleSearchStandard"].Value,
                    user.IsAdmin ? "admin administrator" : "user standard"),
            (rows, sortName, descending) => ApplySort(rows, sortName, descending ? SortOrder.Desc : SortOrder.Asc));
    }

    private static IEnumerable<UserRow> ApplySort(IEnumerable<UserRow> query, string? sortName, SortOrder sortOrder)
    {
        var descending = sortOrder == SortOrder.Desc;
        return sortName switch
        {
            nameof(UserRow.IsAdmin) => descending
                ? query.OrderByDescending(static user => user.IsAdmin).ThenBy(static user => user.UserName, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static user => user.IsAdmin).ThenBy(static user => user.UserName, StringComparer.OrdinalIgnoreCase),
            nameof(UserRow.Id) => descending
                ? query.OrderByDescending(static user => user.Id)
                : query.OrderBy(static user => user.Id),
            nameof(UserRow.Email) => descending
                ? query.OrderByDescending(static user => user.Email, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static user => user.Email, StringComparer.OrdinalIgnoreCase),
            _ => descending
                ? query.OrderByDescending(static user => user.UserName, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static user => user.UserName, StringComparer.OrdinalIgnoreCase),
        };
    }

    private void BeginCreate()
    {
        ResetEditorState();
        _isEditorOpen = true;
        ClearStatus();
    }

    private void BeginEdit(UserRow user)
    {
        _isEditing = true;
        _isEditorOpen = true;
        _editor = new UserEditor
        {
            Id = user.Id,
            UserName = user.UserName,
            Email = user.Email,
            IsAdmin = user.IsAdmin,
        };
        _formErrors.Clear();
        ClearStatus();
    }

    private void ResetEditor()
    {
        if (_isEditing)
        {
            var current = _users.FirstOrDefault(user => user.Id == _editor.Id);
            if (current is not null)
            {
                BeginEdit(current);
                return;
            }
        }

        BeginCreate();
    }

    private void CloseEditor()
    {
        if (_isBusy)
        {
            return;
        }

        _isEditorOpen = false;
        ResetEditorState();
    }

    private async Task SaveAsync()
    {
        _formErrors.Clear();
        ClearStatus();

        ValidateEditor();
        if (_formErrors.Count > 0)
        {
            return;
        }

        _isBusy = true;

        try
        {
            if (_isEditing)
            {
                var result = await UserAdministration.UpdateAsync(
                    _editor.Id,
                    new UpdateUserAdministrationRequest(
                        _editor.UserName.Trim(),
                        NormalizeOptional(_editor.Email),
                        string.IsNullOrWhiteSpace(_editor.Password) ? null : _editor.Password.Trim(),
                        _editor.IsAdmin),
                    _currentUserId);
                CollectErrors(result);
            }
            else
            {
                var result = await UserAdministration.CreateAsync(
                    new CreateUserAdministrationRequest(
                        _editor.UserName.Trim(),
                        _editor.Password.Trim(),
                        NormalizeOptional(_editor.Email),
                        _editor.IsAdmin));
                CollectErrors(result);
            }

            if (_formErrors.Count > 0)
            {
                return;
            }

            await LoadUsersAsync();
            _statusMessage = _isEditing
                ? L["UpdatedUserStatus", _editor.UserName.Trim()].Value
                : L["CreatedUserStatus", _editor.UserName.Trim()].Value;
            _statusIsError = false;
            _isEditorOpen = false;
            _isEditing = false;
            _editor = new UserEditor();
            _formErrors.Clear();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteUserAsync(UserRow user)
    {
        ClearStatus();

        if (user.Id == _currentUserId)
        {
            _statusMessage = L["CannotDeleteCurrentSessionAccount"].Value;
            _statusIsError = true;
            return;
        }

        _isBusy = true;

        try
        {
            var result = await UserAdministration.DeleteAsync(user.Id, _currentUserId);
            if (!result.Succeeded)
            {
                _statusMessage = string.Join(" ", result.Errors.Select(LocalizeApplicationError));
                _statusIsError = true;
                return;
            }

            await LoadUsersAsync();
            _statusMessage = L["DeletedUserStatus", user.UserName].Value;
            _statusIsError = false;

            if (_editor.Id == user.Id)
            {
                _isEditorOpen = false;
                ResetEditorState();
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private static string GetInitial(string value)
    {
        return string.IsNullOrWhiteSpace(value) ? "?" : value.Trim()[0].ToString().ToUpperInvariant();
    }

    private static string FormatShortIdentifier(Guid id)
    {
        return $"{id.ToString()[..8]}...";
    }

    private void ValidateEditor()
    {
        if (string.IsNullOrWhiteSpace(_editor.UserName))
        {
            _formErrors.Add(L["UserNameRequired"].Value);
        }

        if (!_isEditing && string.IsNullOrWhiteSpace(_editor.Password))
        {
            _formErrors.Add(L["PasswordRequiredOnCreate"].Value);
        }

        if (!string.IsNullOrWhiteSpace(_editor.Email) &&
            !new EmailAddressAttribute().IsValid(_editor.Email))
        {
            _formErrors.Add(L["EmailMustBeValid"].Value);
        }
    }

    private void CollectErrors(UserAdministrationResult result)
    {
        if (result.Succeeded)
        {
            return;
        }

        _formErrors.AddRange(result.Errors.Select(LocalizeApplicationError));
    }

    private string LocalizeApplicationError(UserAdministrationError error)
    {
        return error.Code switch
        {
            UserAdministrationErrorCodes.UserNotFound => L["UserNotFound", GetErrorArgument(error)].Value,
            UserAdministrationErrorCodes.CurrentSessionDeletion => L["CannotDeleteCurrentSessionAccount"].Value,
            UserAdministrationErrorCodes.CurrentSessionAdminDemotion => L["CannotRemoveCurrentSessionAdminAccess"].Value,
            UserAdministrationErrorCodes.SavedUserCouldNotBeReloaded => L["SavedUserCouldNotBeReloaded"].Value,
            UserAdministrationErrorCodes.DuplicateUserName => L["DuplicateUserName", GetErrorArgument(error)].Value,
            UserAdministrationErrorCodes.DuplicateEmail => L["DuplicateEmail", GetErrorArgument(error)].Value,
            UserAdministrationErrorCodes.InvalidUserName => L["InvalidUserName", GetErrorArgument(error)].Value,
            UserAdministrationErrorCodes.InvalidEmail => L["InvalidEmail", GetErrorArgument(error)].Value,
            UserAdministrationErrorCodes.PasswordTooShort => L["PasswordTooShort"].Value,
            UserAdministrationErrorCodes.PasswordRequiresNonAlphanumeric => L["PasswordRequiresNonAlphanumeric"].Value,
            UserAdministrationErrorCodes.PasswordRequiresDigit => L["PasswordRequiresDigit"].Value,
            UserAdministrationErrorCodes.PasswordRequiresLower => L["PasswordRequiresLower"].Value,
            UserAdministrationErrorCodes.PasswordRequiresUpper => L["PasswordRequiresUpper"].Value,
            UserAdministrationErrorCodes.PasswordRequiresUniqueChars => L["PasswordRequiresUniqueChars"].Value,
            _ => L["IdentityOperationFailed"].Value,
        };
    }

    private static string GetErrorArgument(UserAdministrationError error)
        => error.Arguments.FirstOrDefault() ?? string.Empty;

    private static string? NormalizeOptional(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? null : value.Trim();
    }

    private void ResetEditorState()
    {
        _isEditing = false;
        _editor = new UserEditor();
        _formErrors.Clear();
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

    private async Task RefreshUsersAsync(int? pageIndex = null)
    {
        if (_table is null)
        {
            await QueryUsersAsync(new QueryPageOptions
            {
                PageIndex = pageIndex ?? CurrentPage,
                PageItems = PageSize,
            });
            StateHasChanged();
            return;
        }

        await _table.QueryAsync(pageIndex);
        StateHasChanged();
    }

    private sealed class UserEditor
    {
        public Guid Id { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string Password { get; set; } = string.Empty;
        public bool IsAdmin { get; set; }
    }

    private sealed class UserRow
    {
        public Guid Id { get; set; }
        public string UserName { get; set; } = string.Empty;
        public string? Email { get; set; }
        public bool IsAdmin { get; set; }
        public string ActionKey { get; set; } = string.Empty;
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        await RefreshUsersAsync(1);
    }

    private async Task HandlePageSizeChange(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize) || pageSize <= 0)
        {
            return;
        }

        _collection.SetPageSize(pageSize);
        await RefreshUsersAsync(1);
    }

    private async Task GoToNextPage()
    {
        if (!CanGoToNextPage)
        {
            return;
        }

        await RefreshUsersAsync(CurrentPage + 1);
    }

    private async Task GoToPreviousPage()
    {
        if (!CanGoToPreviousPage)
        {
            return;
        }

        await RefreshUsersAsync(CurrentPage - 1);
    }

    private async Task GoToPage(int page)
    {
        await RefreshUsersAsync(Math.Clamp(page, 1, TotalPages));
    }

    private Task HandleUserNameChanged(string value)
    {
        _editor.UserName = value;
        return Task.CompletedTask;
    }

    private Task HandleEmailChanged(string? value)
    {
        _editor.Email = value;
        return Task.CompletedTask;
    }

    private Task HandlePasswordChanged(string value)
    {
        _editor.Password = value;
        return Task.CompletedTask;
    }

    private Task HandleIsAdminChanged(bool value)
    {
        _editor.IsAdmin = value;
        return Task.CompletedTask;
    }

    private Task HandleSelectedRowsChanged(IEnumerable<UserRow> selectedRows)
    {
        _collection.ReplaceSelection(selectedRows);
        SyncSelectedUsers(_collection.SelectedItems);
        return Task.CompletedTask;
    }

    private void SyncSelectedUsers(IEnumerable<UserRow> selectedUsers)
    {
        _selectedUsers.Clear();
        _selectedUsers.AddRange(selectedUsers);
    }


}
