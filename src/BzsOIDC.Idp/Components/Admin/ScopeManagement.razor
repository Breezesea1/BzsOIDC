@page "/admin/scopes"
@rendermode InteractiveServer
@using BzsOIDC.Idp.Services.Identity
@using BzsOIDC.Idp.Services.Oidc
@using BzsOIDC.Shared.Infrastructure.Authorization
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject IOidcAdministrationTopology AdministrationTopology
@inject IOidcScopeService ScopeService
@inject IStringLocalizer<ScopeManagement> L
@inject NavigationManager NavigationManager
@layout BzsOIDC.Idp.Client.Components.Layout.MainLayout

<PageTitle>@L["PageTitle"]</PageTitle>

@if (!_hasAccess)
{
    <div class="admin-loading-shell">
        <div class="admin-loading-card">
            <span class="admin-loading-kicker">@L["AdminArea"]</span>
            <h1>@L["CheckingAccess"]</h1>
            <p>@L["CheckingAccessLead"]</p>
        </div>
    </div>
}
else
{
    <section class="admin-page-shell">
        <header class="admin-hero">
            <div>
                <p class="admin-breadcrumb">@L["Overview"] &gt; @L["AppAccess"]</p>
                <h1>@L["PageTitle"]</h1>
                <p>@L["HeroLead"]</p>
            </div>

            <div class="admin-hero-actions">
                <button type="button" class="admin-primary-button" @onclick="BeginCreate" disabled="@_isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    @L["NewScope"]
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="admin-feedback @(_statusIsError ? "is-error" : "is-success")" role="status" aria-live="polite">
                @_statusMessage
            </div>
        }

        <div class="admin-overview-grid">
            <section class="admin-overview-card">
                <header class="admin-overview-card-header">
                    <div>
                        <h2>@L["TopologyOverview"]</h2>
                        <p>@L["TopologyOverviewLead"]</p>
                    </div>
                </header>
                <div class="admin-overview-stats">
                    <span class="admin-user-meta">@L["ScopeCount", _collection.TotalCount]</span>
                    <span class="admin-user-meta">@L["ClientCount", _topology.Clients.Count]</span>
                    <span class="admin-user-meta">@L["PermissionMappingCount", _topology.PermissionCount]</span>
                </div>
                <div class="admin-scope-topology" aria-label="@L["RelationMap"]">
                    <div class="admin-scope-topology-lane">
                        <span class="admin-scope-topology-label">@L["ClientsLabel"]</span>
                        <strong>@_topology.Clients.Count</strong>
                    </div>
                    <span class="admin-scope-topology-link" aria-hidden="true"></span>
                    <div class="admin-scope-topology-lane is-primary">
                        <span class="admin-scope-topology-label">@L["ScopesLabel"]</span>
                        <strong>@_collection.TotalCount</strong>
                    </div>
                    <span class="admin-scope-topology-link" aria-hidden="true"></span>
                    <div class="admin-scope-topology-lane">
                        <span class="admin-scope-topology-label">@L["PermissionsLabel"]</span>
                        <strong>@_topology.PermissionCount</strong>
                    </div>
                </div>
                <div class="admin-scope-relation-preview">
                    @foreach (var relation in GetFeaturedRelations())
                    {
                        <article class="admin-scope-relation-card" @key="relation.ScopeName">
                            <div class="admin-scope-relation-node">
                                <span>@L["ScopeNodeLabel"]</span>
                                <strong>@relation.ScopeName</strong>
                            </div>
                            <div class="admin-scope-relation-branches">
                                <div>
                                    <span>@L["ClientNodeLabel", relation.Clients.Count]</span>
                                    <div class="admin-token-list">
                                        @foreach (var client in GetPreviewItems(relation.Clients))
                                        {
                                            <span class="admin-token">@client</span>
                                        }
                                        @if (GetOverflowCount(relation.Clients) > 0)
                                        {
                                            <span class="admin-token admin-token-overflow">+@GetOverflowCount(relation.Clients)</span>
                                        }
                                        @if (relation.Clients.Count == 0)
                                        {
                                            <span class="admin-user-meta">@L["NoMatchingClients"]</span>
                                        }
                                    </div>
                                </div>
                                <div>
                                    <span>@L["PermissionNodeLabel", relation.Permissions.Count]</span>
                                    <div class="admin-token-list">
                                        @foreach (var permission in GetPreviewItems(relation.Permissions))
                                        {
                                            <span class="admin-token">@permission</span>
                                        }
                                        @if (GetOverflowCount(relation.Permissions) > 0)
                                        {
                                            <span class="admin-token admin-token-overflow">+@GetOverflowCount(relation.Permissions)</span>
                                        }
                                        @if (relation.Permissions.Count == 0)
                                        {
                                            <span class="admin-user-meta">@L["NoMatchingPermissions"]</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </section>
        </div>

        <div class="admin-grid-toolbar">
            <div class="admin-search-stack">
                <div class="admin-search-icon-field">
                    <svg class="admin-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input id="scope-search"
                           class="neo-input admin-search-input"
                           name="scope-search"
                           type="search"
                           placeholder="@L["SearchPlaceholder"]"
                           value="@_searchTerm"
                           @oninput="HandleSearchInput"
                           autocomplete="off"
                           autocapitalize="off"
                           autocorrect="off"
                           spellcheck="false"
                           aria-label="@L["Search"]" />
                </div>
                <span class="admin-grid-summary">@FilteredSummary</span>
            </div>

            <div class="admin-grid-toolbar-actions">
                <button type="button" class="admin-ghost-button admin-toolbar-button" @onclick="LoadScopesAsync" disabled="@_isBusy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <path d="M7 10l5 5 5-5" />
                        <path d="M12 15V3" />
                    </svg>
                    @L["Refresh"]
                </button>
            </div>
        </div>

        <div class="admin-table-shell admin-bootstrap-table" data-testid="scopes-table">
            <Table TItem="ScopeRow"
                   @ref="_table"
                   PageItems="@PageSize"
                   PageItemsSource="PageSizeOptions"
                   IsPagination="false"
                   AllowResizing="true"
                   DefaultFixedColumnWidth="200"
                   ColumnMinWidth="72"
                   ShowColumnWidthTooltip="true"
                   ShowCardView="false"
                   ShowColumnList="false"
                   ShowFilterHeader="false"
                   ShowMultiFilterHeader="false"
                   ShowFooter="false"
                   ShowEmpty="true"
                   ShowLoading="true"
                   ShowLoadingInFirstRender="true"
                   OnQueryAsync="QueryScopesAsync">
                <TableColumns Context="scope">
                    <TableColumn Text="@L["ScopeName"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="Name"
                                 @bind-Field="scope.Name">
                        <Template Context="row">
                            <div class="admin-client-primary-cell">
                                <strong>@row.Row.Name</strong>
                                <span class="admin-user-meta">@L["ScopeUsage", GetScopeClients(row.Row.Name).Count, GetScopePermissions(row.Row.Name).Count]</span>
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["DisplayName"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="DisplayName"
                                 @bind-Field="scope.DisplayName">
                        <Template Context="row">
                            <span class="admin-user-meta">@(string.IsNullOrWhiteSpace(row.Row.DisplayName) ? "—" : row.Row.DisplayName)</span>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Resources"]"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="ResourcesText"
                                 @bind-Field="scope.ResourcesText">
                        <Template Context="row">
                            <div class="admin-token-list">
                                @foreach (var resource in GetPreviewItems(row.Row.Resources))
                                {
                                    <span class="admin-token">@resource</span>
                                }
                                @if (GetOverflowCount(row.Row.Resources) > 0)
                                {
                                    <span class="admin-token admin-token-overflow">+@GetOverflowCount(row.Row.Resources)</span>
                                }
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Description"]"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="Description"
                                 @bind-Field="scope.Description">
                        <Template Context="row">
                            @{
                                var scopeClients = GetScopeClients(row.Row.Name);
                                var scopePermissions = GetScopePermissions(row.Row.Name);
                            }
                            <div class="admin-client-text-stack">
                                <span class="admin-user-meta">@(string.IsNullOrWhiteSpace(row.Row.Description) ? "—" : row.Row.Description)</span>
                                <details class="admin-details-inline">
                                    <summary>@L["ScopeUsageDetails"]</summary>
                                    <div class="admin-details-stack">
                                        <div>
                                            <strong>@L["UsedByClients"]</strong>
                                            <div class="admin-token-list">
                                                @foreach (var client in scopeClients)
                                                {
                                                    <span class="admin-token">@client</span>
                                                }
                                                @if (scopeClients.Count == 0)
                                                {
                                                    <span class="admin-user-meta">@L["NoMatchingClients"]</span>
                                                }
                                            </div>
                                        </div>
                                        <div>
                                            <strong>@L["ReleaseScopeUsage"]</strong>
                                            <div class="admin-token-list">
                                                @foreach (var permission in scopePermissions)
                                                {
                                                    <span class="admin-token">@permission</span>
                                                }
                                                @if (scopePermissions.Count == 0)
                                                {
                                                    <span class="admin-user-meta">@L["NoMatchingPermissions"]</span>
                                                }
                                            </div>
                                        </div>
                                    </div>
                                </details>
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Actions"]"
                                 Filterable="false"
                                 Searchable="false"
                                 Sortable="false"
                                 @bind-Field="scope.ActionKey">
                        <Template Context="row">
                            <div class="admin-actions-column">
                                <button type="button"
                                        class="admin-icon-button"
                                        title="@L["Edit"]"
                                        aria-label="@L["Edit"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => BeginEdit(row.Row)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </button>
                                <button type="button"
                                        class="admin-icon-button danger"
                                        title="@L["Delete"]"
                                        aria-label="@L["Delete"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => DeleteScopeAsync(row.Row.Name)"
                                        disabled="@_isBusy">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4h8v2" />
                                        <path d="M19 6l-1 14H6L5 6" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                    </svg>
                                </button>
                            </div>
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>

        <div class="admin-pagination-bar">
            <span class="admin-pagination-showing">@PageSummary</span>

            <div class="admin-pagination-controls">
                <label class="admin-page-size-field" for="scope-page-size">
                    <span>@L["Rows"]</span>
                    <select id="scope-page-size" class="neo-select admin-page-size-select" value="@PageSize" @onchange="HandlePageSizeChange">
                        @foreach (var option in PageSizeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>

                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToPreviousPage" disabled="@(!CanGoToPreviousPage)">
                    @L["PreviousPage"]
                </button>
                @for (var p = Math.Max(1, CurrentPage - 2); p <= Math.Min(TotalPages, CurrentPage + 2); p++)
                {
                    var pageNum = p;
                    <button type="button" class="admin-pagination-page-btn @(pageNum == CurrentPage ? "is-active" : "")" aria-current="@(pageNum == CurrentPage ? "page" : null)" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToNextPage" disabled="@(!CanGoToNextPage)">
                    @L["NextPage"]
                </button>
            </div>
        </div>

        <ScopeManagementDialog IsOpen="@_isEditorOpen"
                               IsEditing="@_isEditing"
                               IsBusy="@_isBusy"
                               Name="@_editor.Name"
                               NameChanged="HandleNameChanged"
                               DisplayName="@_editor.DisplayName"
                               DisplayNameChanged="HandleDisplayNameChanged"
                               Description="@_editor.Description"
                               DescriptionChanged="HandleDescriptionChanged"
                               ResourcesText="@_editor.ResourcesText"
                               ResourcesTextChanged="HandleResourcesTextChanged"
                               FormErrors="@_formErrors"
                               OnClose="CloseEditor"
                               OnReset="ResetEditor"
                               OnSave="SaveAsync" />
    </section>
}

@code {
    private readonly List<ScopeRow> _scopes = [];
    private OidcAdministrationTopologySnapshot _topology = new([], [], 0);
    private readonly List<string> _formErrors = [];
    private readonly AdminCollection<ScopeRow, string> _collection = new(static scope => scope.Name);
    private static readonly int[] PageSizeOptions = [10, 20, 50];

    private ScopeEditor _editor = new();
    private bool _hasAccess;
    private bool _isBusy;
    private bool _isEditing;
    private bool _isEditorOpen;
    private string _searchTerm = string.Empty;
    private string? _statusMessage;
    private bool _statusIsError;
    private Table<ScopeRow>? _table;

    private int CurrentPage => _collection.CurrentPage;
    private int PageSize => _collection.PageSize;
    private bool CanGoToNextPage => CurrentPage < TotalPages;
    private bool CanGoToPreviousPage => CurrentPage > 1;
    private string FilteredSummary => _collection.TotalCount == 0
        ? L["SearchResultSummaryEmpty"].Value
        : L["SearchResultSummary", _collection.TotalCount].Value;
    private string PageSummary => _collection.TotalCount == 0
        ? L["PageSummaryEmpty"].Value
        : L["PageSummary", _collection.PageStartIndex, _collection.PageEndIndex, _collection.TotalCount].Value;
    private int TotalPages => _collection.TotalPages;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdminAccess())
        {
            return;
        }

        await LoadScopesAsync();
    }

    private bool EnsureAdminAccess()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            var loginPath = QueryHelpers.AddQueryString("/login", new Dictionary<string, string?>
            {
                ["returnUrl"] = "/admin/scopes",
            });

            NavigationManager.NavigateTo(loginPath, forceLoad: true);
            return false;
        }

        if (!user.IsInRole(IdentitySeedConstants.AdminRoleName))
        {
            NavigationManager.NavigateTo("/account/denied", forceLoad: true);
            return false;
        }

        _hasAccess = true;
        return true;
    }

    private async Task LoadScopesAsync()
    {
        _isBusy = true;

        try
        {
            _topology = await AdministrationTopology.ReadAsync();
            _scopes.Clear();
            _scopes.AddRange(_topology.Scopes.Select(ScopeRow.FromTopology));
            _collection.ReplaceRows(_scopes);
            await RefreshScopesAsync(CurrentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task<QueryData<ScopeRow>> QueryScopesAsync(QueryPageOptions options)
    {
        var result = _collection.Query(CreateCollectionQuery(options));

        return Task.FromResult(new QueryData<ScopeRow>
        {
            Items = result.Items,
            TotalCount = result.TotalCount,
            IsFiltered = true,
            IsSorted = true,
            IsSearch = true,
        });
    }

    private AdminCollectionQuery<ScopeRow> CreateCollectionQuery(QueryPageOptions options)
    {
        var searchTerm = _searchTerm.Trim();
        var tableFilter = options.Filters.Count > 0
            ? options.ToFilterFunc<ScopeRow>(StringComparison.OrdinalIgnoreCase)
            : null;

        return new AdminCollectionQuery<ScopeRow>(
            options.PageIndex,
            PageSize,
            options.SortName,
            options.SortOrder == SortOrder.Desc,
            scope => tableFilter is null || tableFilter(scope),
            string.IsNullOrWhiteSpace(searchTerm)
                ? null
                : scope => (
                    scope.Name.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    (!string.IsNullOrWhiteSpace(scope.DisplayName) && scope.DisplayName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    (!string.IsNullOrWhiteSpace(scope.Description) && scope.Description.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)) ||
                    scope.Resources.Any(resource => resource.Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                        ? 0
                        : null,
            (rows, sortName, descending) => ApplySort(rows, sortName, descending ? SortOrder.Desc : SortOrder.Asc));
    }

    private static IEnumerable<ScopeRow> ApplySort(IEnumerable<ScopeRow> query, string? sortName, SortOrder sortOrder)
    {
        var descending = sortOrder == SortOrder.Desc;
        return sortName switch
        {
            nameof(ScopeRow.DisplayName) => descending
                ? query.OrderByDescending(static scope => scope.DisplayName ?? scope.Name, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static scope => scope.DisplayName ?? scope.Name, StringComparer.OrdinalIgnoreCase),
            nameof(ScopeRow.Description) => descending
                ? query.OrderByDescending(static scope => scope.Description ?? string.Empty, StringComparer.OrdinalIgnoreCase).ThenBy(static scope => scope.Name, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static scope => scope.Description ?? string.Empty, StringComparer.OrdinalIgnoreCase).ThenBy(static scope => scope.Name, StringComparer.OrdinalIgnoreCase),
            _ => descending
                ? query.OrderByDescending(static scope => scope.Name, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static scope => scope.Name, StringComparer.OrdinalIgnoreCase),
        };
    }

    private void BeginCreate()
    {
        _editor = new ScopeEditor();
        _isEditing = false;
        _isEditorOpen = true;
        _formErrors.Clear();
        ClearStatus();
    }

    private void BeginEdit(ScopeRow scope)
    {
        _editor = new ScopeEditor
        {
            Name = scope.Name,
            DisplayName = scope.DisplayName ?? string.Empty,
            Description = scope.Description ?? string.Empty,
            ResourcesText = string.Join(Environment.NewLine, scope.Resources),
        };
        _isEditing = true;
        _isEditorOpen = true;
        _formErrors.Clear();
        ClearStatus();
    }

    private void ResetEditor()
    {
        if (_isEditing)
        {
            var current = _scopes.FirstOrDefault(scope => string.Equals(scope.Name, _editor.Name, StringComparison.Ordinal));
            if (current is not null)
            {
                BeginEdit(current);
                return;
            }
        }

        BeginCreate();
    }

    private void CloseEditor()
    {
        if (_isBusy)
        {
            return;
        }

        _isEditorOpen = false;
        _isEditing = false;
        _editor = new ScopeEditor();
        _formErrors.Clear();
    }

    private async Task SaveAsync()
    {
        _formErrors.Clear();
        ClearStatus();

        if (string.IsNullOrWhiteSpace(_editor.Name))
        {
            _formErrors.Add(L["ScopeNameRequired"].Value);
            return;
        }

        _isBusy = true;

        try
        {
            var request = new OidcScopeUpsertRequest
            {
                Name = _editor.Name.Trim(),
                DisplayName = string.IsNullOrWhiteSpace(_editor.DisplayName) ? null : _editor.DisplayName.Trim(),
                Description = string.IsNullOrWhiteSpace(_editor.Description) ? null : _editor.Description.Trim(),
                Resources = ParseLines(_editor.ResourcesText),
            };

            if (_isEditing)
            {
                var result = await ScopeService.UpdateAsync(_editor.Name, request);
                if (result.Status != OidcScopeCommandStatus.Success)
                {
                    AddCommandErrors(result);
                    return;
                }

                _statusMessage = L["UpdatedStatus", _editor.Name].Value;
            }
            else
            {
                var result = await ScopeService.RegisterAsync(request);
                if (result.Status != OidcScopeCommandStatus.Success)
                {
                    AddCommandErrors(result);
                    return;
                }

                _statusMessage = L["CreatedStatus", result.Value?.Name ?? _editor.Name].Value;
            }

            _statusIsError = false;
            await LoadScopesAsync();
            _isEditorOpen = false;
            _isEditing = false;
            _editor = new ScopeEditor();
            _formErrors.Clear();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteScopeAsync(string name)
    {
        ClearStatus();
        _isBusy = true;

        try
        {
            var deleted = await ScopeService.DeleteAsync(name);
            if (!deleted)
            {
                _statusMessage = L["ScopeDeleteFailedStatus", name].Value;
                _statusIsError = true;
                return;
            }

            await LoadScopesAsync();
            _statusMessage = L["DeletedStatus", name].Value;
            _statusIsError = false;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void AddCommandErrors<T>(OidcScopeCommandResult<T> result)
    {
        if (result.Errors.Length > 0)
        {
            _formErrors.AddRange(result.Errors.Select(LocalizeCommandError));
            return;
        }

        _formErrors.Add(result.Status switch
        {
            OidcScopeCommandStatus.Conflict => L["ScopeAlreadyExists"].Value,
            OidcScopeCommandStatus.NotFound => L["ScopeNotFound"].Value,
            _ => L["RequestFailedWithStatus", result.Status].Value,
        });
    }

    private string LocalizeCommandError(string error)
    {
        if (string.IsNullOrWhiteSpace(error))
        {
            return L["UnknownScopeError"].Value;
        }

        if (error.StartsWith("Scope '", StringComparison.Ordinal) && error.EndsWith("' already exists.", StringComparison.Ordinal))
        {
            var name = error[7..^17];
            return L["ScopeAlreadyExistsForName", name].Value;
        }

        if (error.StartsWith("Scope '", StringComparison.Ordinal) && error.EndsWith("' is reserved and cannot be managed here.", StringComparison.Ordinal))
        {
            var name = error[7..^41];
            return L["ReservedScopeError", name].Value;
        }

        return error switch
        {
            "Scope name is required." => L["ScopeNameRequired"].Value,
            "At least one resource is required." => L["ResourcesRequired"].Value,
            _ => L["UnknownScopeError"].Value,
        };
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

    private async Task RefreshScopesAsync(int? pageIndex = null)
    {
        if (_table is null)
        {
            await QueryScopesAsync(new QueryPageOptions
            {
                PageIndex = pageIndex ?? CurrentPage,
                PageItems = PageSize,
            });
            StateHasChanged();
            return;
        }

        await _table.QueryAsync(pageIndex);
        StateHasChanged();
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        await RefreshScopesAsync(1);
    }

    private async Task HandlePageSizeChange(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize) || pageSize <= 0)
        {
            return;
        }

        _collection.SetPageSize(pageSize);
        await RefreshScopesAsync(1);
    }

    private async Task GoToNextPage()
    {
        if (!CanGoToNextPage)
        {
            return;
        }

        await RefreshScopesAsync(CurrentPage + 1);
    }

    private async Task GoToPreviousPage()
    {
        if (!CanGoToPreviousPage)
        {
            return;
        }

        await RefreshScopesAsync(CurrentPage - 1);
    }

    private async Task GoToPage(int page)
    {
        await RefreshScopesAsync(Math.Clamp(page, 1, TotalPages));
    }

    private Task HandleNameChanged(string value)
    {
        _editor.Name = value;
        return Task.CompletedTask;
    }

    private Task HandleDisplayNameChanged(string value)
    {
        _editor.DisplayName = value;
        return Task.CompletedTask;
    }

    private Task HandleDescriptionChanged(string value)
    {
        _editor.Description = value;
        return Task.CompletedTask;
    }

    private Task HandleResourcesTextChanged(string value)
    {
        _editor.ResourcesText = value;
        return Task.CompletedTask;
    }

    private static string[] ParseLines(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return [];
        }

        return raw
            .Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(static value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private static IReadOnlyList<string> GetPreviewItems(IReadOnlyList<string> values)
    {
        return values.Take(2).ToArray();
    }

    private static int GetOverflowCount(IReadOnlyList<string> values)
    {
        return Math.Max(0, values.Count - 2);
    }

    private IReadOnlyList<string> GetScopeClients(string scopeName)
    {
        return FindTopologyScope(scopeName)?.Clients ?? [];
    }

    private IReadOnlyList<string> GetScopePermissions(string scopeName)
    {
        return FindTopologyScope(scopeName)?.Permissions ?? [];
    }

    private OidcAdministrationScope? FindTopologyScope(string scopeName)
        => _topology.Scopes.FirstOrDefault(scope =>
            string.Equals(scope.Name, scopeName, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<ScopeRelationPreview> GetFeaturedRelations()
    {
        return _collection.FilteredItems
            .Select(scope => new ScopeRelationPreview(
                scope.Name,
                GetScopeClients(scope.Name),
                GetScopePermissions(scope.Name)))
            .OrderByDescending(static relation => relation.Clients.Count + relation.Permissions.Count)
            .ThenBy(static relation => relation.ScopeName, StringComparer.OrdinalIgnoreCase)
            .Take(3)
            .ToArray();
    }

    private sealed record ScopeRelationPreview(
        string ScopeName,
        IReadOnlyList<string> Clients,
        IReadOnlyList<string> Permissions);

    private sealed class ScopeEditor
    {
        public string Name { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ResourcesText { get; set; } = string.Empty;
    }

    private sealed class ScopeRow
    {
        public string Name { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public string? Description { get; set; }
        public string[] Resources { get; set; } = [];
        public string ResourcesText { get; set; } = string.Empty;
        public string ActionKey { get; set; } = string.Empty;

        public static ScopeRow FromTopology(OidcAdministrationScope scope)
        {
            return new ScopeRow
            {
                Name = scope.Name,
                DisplayName = scope.DisplayName,
                Description = scope.Description,
                Resources = scope.Resources.ToArray(),
                ResourcesText = string.Join(' ', scope.Resources),
                ActionKey = scope.Name,
            };
        }
    }
}
