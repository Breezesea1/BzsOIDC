@page "/admin/clients"
@rendermode InteractiveServer
@using BzsOIDC.Idp.Services.Identity
@using BzsOIDC.Idp.Services.Oidc
@using BzsOIDC.Shared.Infrastructure.Authorization
@using BootstrapBlazor.Components
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Localization
@inject IHttpContextAccessor HttpContextAccessor
@inject IOidcClientService ClientService
@inject IOidcClientProfile ClientProfile
@inject IOidcScopeService ScopeService
@inject IStringLocalizer<ClientManagement> L
@inject NavigationManager NavigationManager
@layout BzsOIDC.Idp.Client.Components.Layout.MainLayout

<PageTitle>@L["PageTitle"]</PageTitle>

@if (!_hasAccess)
{
    <div class="admin-loading-shell">
        <div class="admin-loading-card">
            <span class="admin-loading-kicker">@L["AdminArea"]</span>
            <h1>@L["CheckingAccess"]</h1>
            <p>@L["CheckingAccessLead"]</p>
        </div>
    </div>
}
else
{
    <section class="admin-page-shell">
        <header class="admin-hero">
            <div>
                <p class="admin-breadcrumb">@L["Overview"] &gt; @L["AppAccess"]</p>
                <h1>@L["PageTitle"]</h1>
                <p>@L["HeroLead"]</p>
            </div>

            <div class="admin-hero-actions">
                <button type="button" class="admin-primary-button" @onclick="BeginCreate" disabled="@_isBusy">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    @L["NewClient"]
                </button>
            </div>
        </header>

        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <div class="admin-feedback @(_statusIsError ? "is-error" : "is-success")" role="status" aria-live="polite">
                @_statusMessage
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_generatedClientSecret))
        {
            <div class="admin-secret-banner" role="alert">
                <div>
                    <strong>@L["ClientSecretGenerated"]</strong>
                    <p>@L["ClientSecretGeneratedLead"]</p>
                </div>
                <code>@_generatedClientSecret</code>
            </div>
        }

        <div class="admin-filter-tabs" role="group" aria-label='@L["FilterByAuthFlow"]'>
            <button type="button" aria-pressed="@(_authFlowFilter == null)" class="admin-filter-tab @(_authFlowFilter == null ? "is-active" : "")" @onclick='() => SetAuthFlowFilter(null)'>
                @L["All"] <span class="admin-tab-count">@_clients.Count</span>
            </button>
            <button type="button" aria-pressed="@(_authFlowFilter == OidcClientAuthFlow.AuthorizationCode)" class="admin-filter-tab @(_authFlowFilter == OidcClientAuthFlow.AuthorizationCode ? "is-active" : "")" @onclick='() => SetAuthFlowFilter(OidcClientAuthFlow.AuthorizationCode)'>
                @L["AuthorizationCodeFlow"] <span class="admin-tab-count">@AuthorizationCodeCount</span>
            </button>
            <button type="button" aria-pressed="@(_authFlowFilter == OidcClientAuthFlow.ClientCredentials)" class="admin-filter-tab @(_authFlowFilter == OidcClientAuthFlow.ClientCredentials ? "is-active" : "")" @onclick='() => SetAuthFlowFilter(OidcClientAuthFlow.ClientCredentials)'>
                @L["ClientCredentialsFlow"] <span class="admin-tab-count">@ClientCredentialsCount</span>
            </button>
        </div>

        <div class="admin-grid-toolbar">
            <div class="admin-search-stack">
                <div class="admin-search-icon-field">
                    <svg class="admin-search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.35-4.35"/>
                    </svg>
                    <input id="client-search"
                            class="neo-input admin-search-input"
                            name="client-search"
                            type="search"
                            placeholder="@L["SearchPlaceholder"]"
                            value="@_searchTerm"
                            @oninput="HandleSearchInput"
                            autocomplete="off"
                            autocapitalize="off"
                            autocorrect="off"
                            spellcheck="false"
                            aria-label="@L["Search"]" />
                </div>
                <span class="admin-grid-summary">@FilteredSummary</span>
            </div>

            <div class="admin-grid-toolbar-actions">
                <button type="button" class="admin-ghost-button admin-toolbar-button" @onclick="LoadClientsAsync" disabled="@_isBusy">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                        <path d="M7 10l5 5 5-5" />
                        <path d="M12 15V3" />
                    </svg>
                    @L["Refresh"]
                </button>
            </div>
        </div>

        <div class="admin-table-shell admin-bootstrap-table" data-testid="clients-table">
            <Table TItem="ClientRow"
                   @ref="_table"
                   PageItems="@PageSize"
                   PageItemsSource="PageSizeOptions"
                   IsPagination="false"
                   AllowResizing="true"
                   DefaultFixedColumnWidth="200"
                   ColumnMinWidth="72"
                   ShowColumnWidthTooltip="true"
                   ShowCardView="false"
                   ShowColumnList="false"
                   ShowFilterHeader="false"
                   ShowMultiFilterHeader="false"
                   ShowFooter="false"
                   ShowEmpty="true"
                   ShowLoading="true"
                   ShowLoadingInFirstRender="true"
                   OnQueryAsync="QueryClientsAsync">
                <TableColumns Context="client">
                    <TableColumn Text="@L["Client"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="ClientId"
                                 @bind-Field="client.ClientId">
                        <Template Context="row">
                            <div class="admin-client-row">
                                <span class="admin-avatar" aria-hidden="true">@GetClientInitial(row.Row)</span>
                                <div class="admin-client-primary-cell">
                                    <strong>@(string.IsNullOrWhiteSpace(row.Row.DisplayName) ? row.Row.ClientId : row.Row.DisplayName)</strong>
                                    <span class="admin-inline-code">@row.Row.ClientId</span>
                                </div>
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["AuthFlow"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="AuthFlow"
                                 @bind-Field="client.AuthFlow">
                        <Template Context="row">
                            <span class="admin-badge @(row.Row.AuthFlow == OidcClientAuthFlow.AuthorizationCode ? "is-admin" : "is-standard")">
                                @FormatAuthFlow(row.Row.AuthFlow)
                            </span>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["ConsentType"]"
                                 Sortable="true"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="ConsentType"
                                 @bind-Field="client.ConsentType">
                        <Template Context="row">
                            <span class="admin-badge @(row.Row.ConsentType == OidcClientConsentType.Explicit ? "is-admin" : "is-standard")">
                                @FormatConsentType(row.Row.ConsentType)
                            </span>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["GrantTypes"]"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="GrantTypesText"
                                 @bind-Field="client.GrantTypesText">
                        <Template Context="row">
                            <div class="admin-token-list">
                                @foreach (var item in GetPreviewItems(row.Row.GrantTypes))
                                {
                                    <span class="admin-token">@item</span>
                                }
                                @if (GetOverflowCount(row.Row.GrantTypes) > 0)
                                {
                                    <span class="admin-token admin-token-overflow">+@GetOverflowCount(row.Row.GrantTypes)</span>
                                }
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Scopes"]"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="ScopesText"
                                 @bind-Field="client.ScopesText">
                        <Template Context="row">
                            <div class="admin-token-list">
                                @foreach (var item in GetPreviewItems(row.Row.Scopes))
                                {
                                    <span class="admin-token">@item</span>
                                }
                                @if (GetOverflowCount(row.Row.Scopes) > 0)
                                {
                                    <span class="admin-token admin-token-overflow">+@GetOverflowCount(row.Row.Scopes)</span>
                                }
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["RedirectUris"]"
                                 Searchable="true"
                                 Filterable="false"
                                 SortName="RedirectUrisText"
                                 @bind-Field="client.RedirectUrisText">
                        <Template Context="row">
                            @{ var uriPreviewSource = GetUriPreviewSource(row.Row); }
                            <div class="admin-client-text-stack">
                                @if (uriPreviewSource.Count == 0)
                                {
                                    <span class="admin-user-meta">—</span>
                                }
                                else
                                {
                                    @foreach (var uri in GetPreviewItems(uriPreviewSource))
                                    {
                                        <span class="admin-user-meta admin-uri-preview">@uri</span>
                                    }
                                    @if (GetOverflowCount(uriPreviewSource) > 0)
                                    {
                                        <span class="admin-user-meta">@L["MoreCount", GetOverflowCount(uriPreviewSource)]</span>
                                    }
                                }
                            </div>
                        </Template>
                    </TableColumn>
                    <TableColumn Text="@L["Actions"]"
                                 Filterable="false"
                                 Searchable="false"
                                 Sortable="false"
                                 @bind-Field="client.ActionKey">
                        <Template Context="row">
                            <div class="admin-actions-column">
                                <button type="button"
                                        class="admin-icon-button"
                                        title="@L["Edit"]"
                                        aria-label="@L["Edit"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => BeginEdit(row.Row)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M12 20h9" />
                                        <path d="M16.5 3.5a2.121 2.121 0 1 1 3 3L7 19l-4 1 1-4Z" />
                                    </svg>
                                </button>
                                <button type="button"
                                        class="admin-icon-button danger"
                                        title="@L["Delete"]"
                                        aria-label="@L["Delete"]"
                                        @onclick:stopPropagation="true"
                                        @onclick="() => DeleteClientAsync(row.Row.ClientId)"
                                        disabled="@_isBusy">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M3 6h18" />
                                        <path d="M8 6V4h8v2" />
                                        <path d="M19 6l-1 14H6L5 6" />
                                        <path d="M10 11v6" />
                                        <path d="M14 11v6" />
                                    </svg>
                                </button>
                            </div>
                        </Template>
                    </TableColumn>
                </TableColumns>
            </Table>
        </div>

        <div class="admin-pagination-bar">
            <span class="admin-pagination-showing">@PageSummary</span>
            
            <div class="admin-pagination-controls">
                <label class="admin-page-size-field" for="client-page-size">
                    <span>@L["Rows"]</span>
                    <select id="client-page-size" class="neo-select admin-page-size-select" value="@PageSize" @onchange="HandlePageSizeChange">
                        @foreach (var option in PageSizeOptions)
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </label>

                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToPreviousPage" disabled="@(!CanGoToPreviousPage)">
                    @L["PreviousPage"]
                </button>
                @for (var p = Math.Max(1, CurrentPage - 2); p <= Math.Min(TotalPages, CurrentPage + 2); p++)
                {
                    var pageNum = p;
                    <button type="button" class="admin-pagination-page-btn @(pageNum == CurrentPage ? "is-active" : "")" aria-current="@(pageNum == CurrentPage ? "page" : null)" @onclick="() => GoToPage(pageNum)">
                        @pageNum
                    </button>
                }
                <button type="button" class="admin-ghost-button admin-pagination-btn" @onclick="GoToNextPage" disabled="@(!CanGoToNextPage)">
                    @L["NextPage"]
                </button>
            </div>
        </div>

        <ClientManagementDialog IsOpen="@_isEditorOpen"
                                IsEditing="@_isEditing"
                                IsBusy="@_isBusy"
                                ClientId="@_editor.ClientId"
                                ClientIdChanged="HandleClientIdChanged"
                                DisplayName="@_editor.DisplayName"
                                DisplayNameChanged="HandleDisplayNameChanged"
                                AuthFlow="@_editor.AuthFlow"
                                AuthFlowChanged="HandleAuthFlowChanged"
                                ConsentType="@_editor.ConsentType"
                                ConsentTypeChanged="HandleConsentTypeChanged"
                                ScopesText="@_editor.ScopesText"
                                ScopesTextChanged="HandleScopesTextChanged"
                                RedirectUrisText="@_editor.RedirectUrisText"
                                RedirectUrisTextChanged="HandleRedirectUrisTextChanged"
                                PostLogoutRedirectUrisText="@_editor.PostLogoutRedirectUrisText"
                                PostLogoutRedirectUrisTextChanged="HandlePostLogoutRedirectUrisTextChanged"
                                AvailableScopeOptions="@_availableScopes"
                                ClientSecret="@_editor.ClientSecret"
                                ClientSecretChanged="HandleClientSecretChanged"
                                FormErrors="@_formErrors"
                                OnClose="CloseEditor"
                                OnReset="ResetEditor"
                                OnSave="SaveAsync" />
    </section>
}

@code {
    private readonly List<ClientRow> _clients = [];
    private readonly List<string> _availableScopes = [];
    private readonly List<string> _formErrors = [];
    private readonly AdminCollection<ClientRow, string> _collection = new(static client => client.ClientId);
    private static readonly int[] PageSizeOptions = [10, 20, 50];

    private ClientEditor _editor = new();
    private bool _hasAccess;
    private bool _isBusy;
    private bool _isEditing;
    private bool _isEditorOpen;
    private string _searchTerm = string.Empty;
    private OidcClientAuthFlow? _authFlowFilter;
    private string? _generatedClientSecret;
    private string? _statusMessage;
    private bool _statusIsError;
    private Table<ClientRow>? _table;

    private int AuthorizationCodeCount => _clients.Count(static client => client.AuthFlow == OidcClientAuthFlow.AuthorizationCode);
    private int ClientCredentialsCount => _clients.Count(static client => client.AuthFlow == OidcClientAuthFlow.ClientCredentials);
    private int CurrentPage => _collection.CurrentPage;
    private int PageSize => _collection.PageSize;
    private bool CanGoToNextPage => CurrentPage < TotalPages;
    private bool CanGoToPreviousPage => CurrentPage > 1;
    private string FilteredSummary => _collection.TotalCount == 0
        ? L["SearchResultSummaryEmpty"].Value
        : L["SearchResultSummary", _collection.TotalCount].Value;
    private string PageSummary => _collection.TotalCount == 0
        ? L["PageSummaryEmpty"].Value
        : L["PageSummary", _collection.PageStartIndex, _collection.PageEndIndex, _collection.TotalCount].Value;
    private int TotalPages => _collection.TotalPages;

    protected override async Task OnInitializedAsync()
    {
        if (!EnsureAdminAccess())
        {
            return;
        }

        await LoadClientsAsync();
    }

    private bool EnsureAdminAccess()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            var loginPath = QueryHelpers.AddQueryString("/login", new Dictionary<string, string?>
            {
                ["returnUrl"] = "/admin/clients",
            });

            NavigationManager.NavigateTo(loginPath, forceLoad: true);
            return false;
        }

        if (!user.IsInRole(IdentitySeedConstants.AdminRoleName))
        {
            NavigationManager.NavigateTo("/account/denied", forceLoad: true);
            return false;
        }

        _hasAccess = true;
        return true;
    }

    private async Task LoadClientsAsync()
    {
        _isBusy = true;

        try
        {
            _clients.Clear();
            _clients.AddRange((await ClientService.GetAllAsync()).Select(ClientRow.FromResponse));
            _availableScopes.Clear();
            _availableScopes.AddRange((await ScopeService.GetAllAsync()).Select(static scope => scope.Name));
            _availableScopes.Sort(StringComparer.OrdinalIgnoreCase);
            _collection.ReplaceRows(_clients);
            await RefreshClientsAsync(CurrentPage);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private Task<QueryData<ClientRow>> QueryClientsAsync(QueryPageOptions options)
    {
        var result = _collection.Query(CreateCollectionQuery(options));

        return Task.FromResult(new QueryData<ClientRow>
        {
            Items = result.Items,
            TotalCount = result.TotalCount,
            IsFiltered = true,
            IsSorted = true,
            IsSearch = true,
        });
    }

    private AdminCollectionQuery<ClientRow> CreateCollectionQuery(QueryPageOptions options)
    {
        var searchTerm = _searchTerm.Trim();
        var tableFilter = options.Filters.Count > 0
            ? options.ToFilterFunc<ClientRow>(StringComparison.OrdinalIgnoreCase)
            : null;

        return new AdminCollectionQuery<ClientRow>(
            options.PageIndex,
            PageSize,
            options.SortName,
            options.SortOrder == SortOrder.Desc,
            client =>
                (!_authFlowFilter.HasValue || client.AuthFlow == _authFlowFilter.Value) &&
                (tableFilter is null || tableFilter(client)),
            string.IsNullOrWhiteSpace(searchTerm)
                ? null
                : client => AdminTableSearch.Score(
                    searchTerm,
                    client.ClientId,
                    client.DisplayName,
                    FormatAuthFlow(client.AuthFlow),
                    FormatConsentType(client.ConsentType),
                    client.GrantTypesText,
                    client.ScopesText,
                    client.RedirectUrisText),
            (rows, sortName, descending) => ApplySort(rows, sortName, descending ? SortOrder.Desc : SortOrder.Asc));
    }

    private static IEnumerable<ClientRow> ApplySort(IEnumerable<ClientRow> query, string? sortName, SortOrder sortOrder)
    {
        var descending = sortOrder == SortOrder.Desc;
        return sortName switch
        {
            nameof(ClientRow.AuthFlow) => descending
                ? query.OrderByDescending(static client => client.AuthFlow).ThenBy(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static client => client.AuthFlow).ThenBy(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase),
            nameof(ClientRow.ConsentType) => descending
                ? query.OrderByDescending(static client => client.ConsentType).ThenBy(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static client => client.ConsentType).ThenBy(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase),
            nameof(ClientRow.DisplayName) => descending
                ? query.OrderByDescending(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static client => client.DisplayName ?? client.ClientId, StringComparer.OrdinalIgnoreCase),
            _ => descending
                ? query.OrderByDescending(static client => client.ClientId, StringComparer.OrdinalIgnoreCase)
                : query.OrderBy(static client => client.ClientId, StringComparer.OrdinalIgnoreCase),
        };
    }

    private void BeginCreate()
    {
        ResetEditorState();
        _isEditorOpen = true;
        ClearStatus();
    }

    private void BeginEdit(ClientRow client)
    {
        _isEditing = true;
        _isEditorOpen = true;
        _editor = new ClientEditor
        {
            ClientId = client.ClientId,
            DisplayName = client.DisplayName ?? string.Empty,
            AuthFlow = client.AuthFlow,
            ConsentType = client.ConsentType,
            ScopesText = string.Join(Environment.NewLine, client.Scopes),
            RedirectUrisText = string.Join(Environment.NewLine, client.RedirectUris),
            PostLogoutRedirectUrisText = string.Join(Environment.NewLine, client.PostLogoutRedirectUris),
        };
        _generatedClientSecret = null;
        _formErrors.Clear();
        ClearStatus();
    }

    private void ResetEditor()
    {
        if (_isEditing)
        {
            var current = _clients.FirstOrDefault(client => string.Equals(client.ClientId, _editor.ClientId, StringComparison.Ordinal));
            if (current is not null)
            {
                BeginEdit(current);
                return;
            }
        }

        BeginCreate();
    }

    private void CloseEditor()
    {
        if (_isBusy)
        {
            return;
        }

        _isEditorOpen = false;
        ResetEditorState();
    }

    private async Task SaveAsync()
    {
        _formErrors.Clear();
        ClearStatus();
        _generatedClientSecret = null;

        ValidateEditor();
        if (_formErrors.Count > 0)
        {
            return;
        }

        _isBusy = true;

        try
        {
            var request = BuildRequest();

            if (_isEditing)
            {
                var result = await ClientService.UpdateAsync(_editor.ClientId, request);
                if (result.Status != OidcClientCommandStatus.Success)
                {
                    AddCommandErrors(result);
                    return;
                }

                _statusMessage = L["UpdatedStatus", _editor.ClientId].Value;
            }
            else
            {
                var result = await ClientService.RegisterAsync(request);
                if (result.Status != OidcClientCommandStatus.Success)
                {
                    AddCommandErrors(result);
                    return;
                }

                _statusMessage = L["RegisteredStatus", result.Value?.ClientId ?? _editor.DisplayName].Value;
                _generatedClientSecret = result.Value?.ClientSecret;
            }

            _statusIsError = false;
            await LoadClientsAsync();
            _isEditorOpen = false;
            _isEditing = false;
            _editor = CreateDefaultEditor();
            _formErrors.Clear();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task DeleteClientAsync(string clientId)
    {
        ClearStatus();
        _generatedClientSecret = null;
        _isBusy = true;

        try
        {
            var deleted = await ClientService.DeleteAsync(clientId);
            if (!deleted)
            {
                _statusMessage = L["ClientNoLongerExistsStatus", clientId].Value;
                _statusIsError = true;
                return;
            }

            await LoadClientsAsync();
            _statusMessage = L["DeletedStatus", clientId].Value;
            _statusIsError = false;

            if (string.Equals(_editor.ClientId, clientId, StringComparison.Ordinal))
            {
                _isEditorOpen = false;
                ResetEditorState();
            }
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void ValidateEditor()
    {
        if (string.IsNullOrWhiteSpace(_editor.DisplayName))
        {
            _formErrors.Add(L["DisplayNameRequired"].Value);
        }

        var scopes = ParseLines(_editor.ScopesText);
        if (scopes.Length == 0)
        {
            _formErrors.Add(L["AtLeastOneScopeRequired"].Value);
        }

        if (_editor.AuthFlow == OidcClientAuthFlow.AuthorizationCode && ParseLines(_editor.RedirectUrisText).Length == 0)
        {
            _formErrors.Add(L["InteractiveClientRedirectRequired"].Value);
        }
    }

    private OidcClientUpsertRequest BuildRequest()
    {
        return ClientProfile.CreateRequest(new OidcClientProfileDraft
        {
            ClientId = string.IsNullOrWhiteSpace(_editor.ClientId) ? null : _editor.ClientId.Trim(),
            ClientSecret = string.IsNullOrWhiteSpace(_editor.ClientSecret) ? null : _editor.ClientSecret.Trim(),
            DisplayName = _editor.DisplayName.Trim(),
            AuthFlow = _editor.AuthFlow,
            ConsentType = _editor.ConsentType,
            Scopes = ParseLines(_editor.ScopesText),
            RedirectUris = ParseLines(_editor.RedirectUrisText),
            PostLogoutRedirectUris = ParseLines(_editor.PostLogoutRedirectUrisText),
        });
    }

    private void AddCommandErrors<T>(OidcClientCommandResult<T> result)
    {
        if (result.Errors.Length > 0)
        {
            _formErrors.AddRange(result.Errors.Select(LocalizeCommandError));
            return;
        }

        _formErrors.Add(result.Status switch
        {
            OidcClientCommandStatus.Conflict => L["ClientAlreadyExists"].Value,
            OidcClientCommandStatus.NotFound => L["ClientNotFound"].Value,
            _ => L["RequestFailedWithStatus", result.Status].Value,
        });
    }

    private string LocalizeCommandError(string error)
    {
        if (string.IsNullOrWhiteSpace(error))
        {
            return L["UnknownClientError"].Value;
        }

        if (error.StartsWith("Client '", StringComparison.Ordinal) && error.EndsWith("' already exists.", StringComparison.Ordinal))
        {
            var clientId = error[8..^17];
            return L["ClientAlreadyExistsForId", clientId].Value;
        }

        if (error.StartsWith("Invalid URI: '", StringComparison.Ordinal) && error.EndsWith("'.", StringComparison.Ordinal))
        {
            var uri = error[14..^2];
            return L["InvalidUri", uri].Value;
        }

        return error switch
        {
            "DisplayName is required." => L["DisplayNameRequired"].Value,
            "Public clients must not specify ClientSecret." => L["PublicClientsMustNotSpecifyClientSecret"].Value,
            "At least one grant type must be provided." => L["AtLeastOneGrantTypeRequired"].Value,
            "Authorization code clients must provide at least one redirect URI." => L["AuthorizationCodeRedirectRequired"].Value,
            "Authorization Code Flow clients must be public clients in the current onboarding." => L["AuthorizationCodeClientsMustBePublic"].Value,
            "Authorization Code Flow clients only support authorization_code and refresh_token grants." => L["AuthorizationCodeClientsGrantTypesInvalid"].Value,
            "Authorization Code Flow clients only support implicit or explicit consent." => L["AuthorizationCodeClientsConsentInvalid"].Value,
            "Authorization Code Flow clients must require PKCE." => L["AuthorizationCodeClientsMustRequirePkce"].Value,
            "Client Credentials Flow clients must be confidential clients." => L["ClientCredentialsClientsMustBeConfidential"].Value,
            "Client Credentials Flow clients only support the client_credentials grant." => L["ClientCredentialsClientsGrantTypesInvalid"].Value,
            "Client Credentials Flow clients must use external consent." => L["ClientCredentialsClientsConsentInvalid"].Value,
            "Client Credentials Flow clients must not configure redirect URIs." => L["ClientCredentialsClientsMustNotConfigureRedirectUris"].Value,
            "Client Credentials Flow clients must not configure post logout redirect URIs." => L["ClientCredentialsClientsMustNotConfigurePostLogoutRedirectUris"].Value,
            "Current onboarding only supports Authorization Code Flow (public + auth code/refresh token + PKCE) and Client Credentials Flow (confidential + client_credentials) clients." => L["UnsupportedAuthFlow"].Value,
            _ => L["UnknownClientError"].Value,
        };
    }

    private static string[] ParseLines(string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw))
        {
            return [];
        }

        return raw
            .Split([',', '\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(static value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToArray();
    }

    private string FormatAuthFlow(OidcClientAuthFlow authFlow)
    {
        return authFlow switch
        {
            OidcClientAuthFlow.AuthorizationCode => L["AuthorizationCodeFlow"].Value,
            OidcClientAuthFlow.ClientCredentials => L["ClientCredentialsFlow"].Value,
            _ => authFlow.ToString(),
        };
    }

    private string FormatConsentType(OidcClientConsentType consentType)
    {
        return consentType switch
        {
            OidcClientConsentType.Implicit => L["ConsentImplicit"].Value,
            OidcClientConsentType.Explicit => L["ConsentExplicit"].Value,
            OidcClientConsentType.External => L["ConsentExternal"].Value,
            OidcClientConsentType.Unknown => L["ConsentUnknown"].Value,
            _ => consentType.ToString(),
        };
    }

    private static string GetClientInitial(ClientRow client)
    {
        var name = string.IsNullOrWhiteSpace(client.DisplayName) ? client.ClientId : client.DisplayName;
        return string.IsNullOrWhiteSpace(name) ? "?" : name[0].ToString().ToUpperInvariant();
    }

    private IReadOnlyList<string> GetUriPreviewSource(ClientRow client)
    {
        if (client.RedirectUris.Length == 0 && client.PostLogoutRedirectUris.Length == 0)
        {
            return [];
        }

        return client.RedirectUris.Length > 0 ? client.RedirectUris : client.PostLogoutRedirectUris;
    }

    private static IReadOnlyList<string> GetPreviewItems(IReadOnlyList<string> values)
    {
        return values.Take(2).ToArray();
    }

    private static int GetOverflowCount(IReadOnlyList<string> values)
    {
        return Math.Max(0, values.Count - 2);
    }

    private ClientEditor CreateDefaultEditor()
    {
        return new ClientEditor
        {
            AuthFlow = OidcClientAuthFlow.AuthorizationCode,
            ConsentType = ClientProfile.GetDefaultConsentType(OidcClientAuthFlow.AuthorizationCode),
            ScopesText = PermissionConstants.ScopeApi,
        };
    }

    private void ResetEditorState()
    {
        _isEditing = false;
        _editor = CreateDefaultEditor();
        _formErrors.Clear();
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        _statusIsError = false;
    }

    private async Task RefreshClientsAsync(int? pageIndex = null)
    {
        if (_table is null)
        {
            await QueryClientsAsync(new QueryPageOptions
            {
                PageIndex = pageIndex ?? CurrentPage,
                PageItems = PageSize,
            });
            StateHasChanged();
            return;
        }

        await _table.QueryAsync(pageIndex);
        StateHasChanged();
    }

    private async Task HandleSearchInput(ChangeEventArgs args)
    {
        _searchTerm = args.Value?.ToString() ?? string.Empty;
        await RefreshClientsAsync(1);
    }

    private async Task HandlePageSizeChange(ChangeEventArgs args)
    {
        if (!int.TryParse(args.Value?.ToString(), out var pageSize) || pageSize <= 0)
        {
            return;
        }

        _collection.SetPageSize(pageSize);
        await RefreshClientsAsync(1);
    }

    private async Task GoToNextPage()
    {
        if (!CanGoToNextPage)
        {
            return;
        }

        await RefreshClientsAsync(CurrentPage + 1);
    }

    private async Task GoToPreviousPage()
    {
        if (!CanGoToPreviousPage)
        {
            return;
        }

        await RefreshClientsAsync(CurrentPage - 1);
    }

    private async Task GoToPage(int page)
    {
        await RefreshClientsAsync(Math.Clamp(page, 1, TotalPages));
    }

    private Task HandleClientIdChanged(string value)
    {
        _editor.ClientId = value;
        return Task.CompletedTask;
    }

    private Task HandleClientSecretChanged(string value)
    {
        _editor.ClientSecret = value;
        return Task.CompletedTask;
    }

    private Task HandleDisplayNameChanged(string value)
    {
        _editor.DisplayName = value;
        return Task.CompletedTask;
    }

    private Task HandleAuthFlowChanged(OidcClientAuthFlow value)
    {
        _editor.AuthFlow = value;

        if (value == OidcClientAuthFlow.AuthorizationCode)
        {
            _editor.ClientSecret = string.Empty;
            if (_editor.ConsentType == OidcClientConsentType.External)
            {
                _editor.ConsentType = ClientProfile.GetDefaultConsentType(value);
            }
        }
        else
        {
            _editor.RedirectUrisText = string.Empty;
            _editor.PostLogoutRedirectUrisText = string.Empty;
            _editor.ConsentType = ClientProfile.GetDefaultConsentType(value);
        }

        return Task.CompletedTask;
    }

    private Task HandleScopesTextChanged(string value)
    {
        _editor.ScopesText = value;
        return Task.CompletedTask;
    }

    private Task HandleConsentTypeChanged(OidcClientConsentType value)
    {
        _editor.ConsentType = value;
        return Task.CompletedTask;
    }

    private Task HandleRedirectUrisTextChanged(string value)
    {
        _editor.RedirectUrisText = value;
        return Task.CompletedTask;
    }

    private Task HandlePostLogoutRedirectUrisTextChanged(string value)
    {
        _editor.PostLogoutRedirectUrisText = value;
        return Task.CompletedTask;
    }

    private async Task SetAuthFlowFilter(OidcClientAuthFlow? filter)
    {
        _authFlowFilter = filter;
        await RefreshClientsAsync(1);
    }

    private sealed class ClientEditor
    {
        public string ClientId { get; set; } = string.Empty;
        public string ClientSecret { get; set; } = string.Empty;
        public string DisplayName { get; set; } = string.Empty;
        public OidcClientAuthFlow AuthFlow { get; set; }
        public OidcClientConsentType ConsentType { get; set; } = OidcClientConsentType.Implicit;
        public string ScopesText { get; set; } = string.Empty;
        public string RedirectUrisText { get; set; } = string.Empty;
        public string PostLogoutRedirectUrisText { get; set; } = string.Empty;
    }

    private sealed class ClientRow
    {
        public string ClientId { get; set; } = string.Empty;
        public string? DisplayName { get; set; }
        public OidcClientAuthFlow AuthFlow { get; set; }
        public OidcClientConsentType ConsentType { get; set; }
        public string[] GrantTypes { get; set; } = [];
        public string[] Scopes { get; set; } = [];
        public string[] RedirectUris { get; set; } = [];
        public string[] PostLogoutRedirectUris { get; set; } = [];
        public string GrantTypesText { get; set; } = string.Empty;
        public string ScopesText { get; set; } = string.Empty;
        public string RedirectUrisText { get; set; } = string.Empty;
        public string ActionKey { get; set; } = string.Empty;

        public static ClientRow FromResponse(OidcClientResponse response)
        {
            return new ClientRow
            {
                ClientId = response.ClientId,
                DisplayName = response.DisplayName,
                AuthFlow = response.AuthFlow,
                ConsentType = response.ConsentType,
                GrantTypes = response.GrantTypes,
                Scopes = response.Scopes,
                RedirectUris = response.RedirectUris,
                PostLogoutRedirectUris = response.PostLogoutRedirectUris,
                GrantTypesText = string.Join(' ', response.GrantTypes),
                ScopesText = string.Join(' ', response.Scopes),
                RedirectUrisText = string.Join(' ', response.RedirectUris.Concat(response.PostLogoutRedirectUris)),
                ActionKey = response.ClientId,
            };
        }
    }
}
